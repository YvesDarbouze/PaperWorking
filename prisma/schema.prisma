generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DealFinancials {
  id                  String            @id @default(uuid())
  organizationId      String
  linkedDealId        String?           @unique
  purchasePrice       BigInt            @default(0)
  salePrice           BigInt            @default(0)
  closingCosts        BigInt            @default(0)
  renovationCosts     BigInt            @default(0)
  holdingCosts        BigInt            @default(0)
  totalPayouts        BigInt            @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  actualRehabCost     BigInt?
  actualRentalIncome  BigInt?
  capitalRaiseTarget  BigInt?
  committedCapital    BigInt?
  daysOccupied        Int?
  targetPurchasePrice BigInt?
  totalHoldDays       Int?
  payouts             PayoutWaterfall[]

  @@index([organizationId])
}

model PayoutWaterfall {
  id           String         @id @default(uuid())
  financialsId String
  payeeName    String
  payeeRole    String
  payoutAmount BigInt
  isConfirmed  Boolean        @default(false)
  linkedItemId String?        @unique
  status       String         @default("Pending")
  createdAt    DateTime       @default(now())
  financials   DealFinancials @relation(fields: [financialsId], references: [id], onDelete: Cascade)

  @@index([financialsId])
}

model PhaseTransition {
  id              String   @id @default(uuid())
  linkedProjectId String
  fromPhase       String
  toPhase         String
  transitionDate  DateTime @default(now())
  userUid         String
  notes           String?

  @@index([linkedProjectId])
}

model CommunicationLog {
  id                String   @id @default(uuid())
  linkedProjectId   String
  organizationId    String
  type              String
  direction         String
  fromAddress       String
  toAddress         String
  subject           String?
  body              String
  threadId          String?
  createdAt         DateTime @default(now())
  providerMessageId String?  @unique

  @@index([linkedProjectId])
  @@index([organizationId])
  @@index([threadId])
}

/// Per-recipient delivery tracking for transactional emails.
/// Updated by Resend webhook events (Sent → Delivered → Opened → Clicked).
model EmailLog {
  id              String    @id @default(uuid())
  organizationId  String
  recipientId     String?
  recipientEmail  String
  templateSlug    String
  linkedProjectId String?
  status          String    @default("Sent")
  subject         String?
  sentAt          DateTime  @default(now())
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  errorMessage    String?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messageId       String

  @@index([organizationId])
  @@index([recipientEmail])
  @@index([messageId])
  @@index([templateSlug])
  @@index([status])
  @@index([linkedProjectId])
}

model Property {
  id                          String   @id @default(uuid())
  listingKey                  String   @unique
  listingId                   String   @unique
  standardStatus              String?
  listPrice                   BigInt?
  unparsedAddress             String?
  bedroomsTotal               Int?
  bathroomsFull               Int?
  bathroomsHalf               Int?
  livingArea                  Int?
  lotSizeAcres                Float?
  yearBuilt                   Int?
  publicRemarks               String?
  media                       String?
  bridgeModificationTimestamp DateTime
  coordinates                 String?
  feedTypes                   String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([standardStatus])
  @@index([bridgeModificationTimestamp])
}

model BridgeSyncState {
  id                              String   @id
  mostRecentModificationTimestamp DateTime
  updatedAt                       DateTime @updatedAt
}

model Member {
  id                    String    @id @default(uuid())
  memberKey             String    @unique
  memberMlsId           String?
  memberFullName        String?
  memberFirstName       String?
  memberLastName        String?
  memberEmail           String?
  memberDirectPhone     String?
  memberMobilePhone     String?
  memberStateLicense    String?
  memberDesignation     String?
  officeName            String?
  officeKey             String?
  officeMlsId           String?
  media                 String?
  modificationTimestamp DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([memberFullName])
  @@index([officeKey])
  @@index([modificationTimestamp])
}

model Office {
  id                    String    @id @default(uuid())
  officeKey             String    @unique
  officeMlsId           String?
  officeName            String?
  officePhone           String?
  officeEmail           String?
  officeAddress1        String?
  officeCity            String?
  officeStateOrProvince String?
  officePostalCode      String?
  officeType            String?
  officeStatus          String?
  modificationTimestamp DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([officeName])
  @@index([modificationTimestamp])
}

model JobRecord {
  id         String    @id
  type       String
  status     String    @default("pending")
  payload    String
  attempts   Int       @default(0)
  error      String?
  enqueuedAt DateTime
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([type, status])
  @@index([enqueuedAt])
}

model SourcingLead {
  id                 String   @id @default(uuid())
  organizationId     String
  sourceVendor       String
  sourceReferenceId  String?
  address            String
  city               String?
  state              String?
  zipCode            String?
  propertyType       String?
  estimatedValue     BigInt?
  ownerName          String?
  ownerContact       String?
  criteriaVersion    String   @default("v1")
  costPerLead        BigInt?
  estimatedMargin    BigInt?
  ownershipShares    Json?
  status             String   @default("New")
  convertedProjectId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([sourceVendor])
}

model RehabProject {
  id              String           @id @default(uuid())
  linkedProjectId String           @unique
  organizationId  String
  status          String           @default("Planning")
  estimatedBudget BigInt           @default(0)
  actualCost      BigInt           @default(0)
  startDate       DateTime?
  endDate         DateTime?
  ownershipShares Json?
  criteriaVersion String           @default("v1")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  changeOrders    ChangeOrder[]
  documents       RehabDocument[]
  milestones      RehabMilestone[]

  @@index([organizationId])
  @@index([status])
}

model RehabMilestone {
  id             String         @id @default(uuid())
  rehabProjectId String
  title          String
  description    String?
  status         String         @default("Pending")
  estimatedCost  BigInt         @default(0)
  actualCost     BigInt         @default(0)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  invoices       RehabInvoice[]
  rehabProject   RehabProject   @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)
  bids           VendorBid[]

  @@index([rehabProjectId])
}

model Vendor {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  type           String
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  invoices       RehabInvoice[]
  bids           VendorBid[]

  @@index([organizationId])
}

model VendorBid {
  id          String         @id @default(uuid())
  vendorId    String
  milestoneId String
  bidAmount   BigInt
  status      String         @default("Pending")
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  milestone   RehabMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([milestoneId])
}

model RehabInvoice {
  id          String         @id @default(uuid())
  vendorId    String
  milestoneId String
  amount      BigInt
  status      String         @default("Pending")
  documentUrl String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  milestone   RehabMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([milestoneId])
}

model ChangeOrder {
  id             String       @id @default(uuid())
  rehabProjectId String
  description    String
  requestedCost  BigInt
  approvedCost   BigInt?
  status         String       @default("Pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  rehabProject   RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)

  @@index([rehabProjectId])
}

model RehabDocument {
  id             String       @id @default(uuid())
  rehabProjectId String
  title          String
  type           String
  fileUrl        String
  createdAt      DateTime     @default(now())
  rehabProject   RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)

  @@index([rehabProjectId])
}

model AppUser {
  id                      String                       @id
  email                   String                       @unique
  name                    String?
  role                    String?
  stripeCustomerId        String?                      @unique
  syntheticAgent          Boolean                      @default(false)
  agentPersona            String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  fieldAssignedBy         FieldAssignment[]            @relation("FieldAssignedBy")
  fieldAssignedTo         FieldAssignment[]            @relation("FieldAssignedTo")
  collaborations          ProjectCollaborator[]
  projects                ReilProject[]
  statusEvents            StatusEvent[]
  // New financial layer relations
  plaidConnections        PlaidConnection[]
  financialTransactions   FinancialTransaction[]
  transactionRules        TransactionRule[]
  notificationPreferences UserNotificationPreferences?
  sentEmailLogs           SentEmailLog[]
  reconciledPeriods       ReconciliationPeriod[]
}

model ReilProject {
  id                 String              @id @default(uuid())
  addressLine        String              @default("")
  city               String              @default("")
  state              String              @default("")
  zip                String              @default("")
  lat                Float?
  lng                Float?
  placeId            String?
  displayName        String?
  acquisitionStatus  AcquisitionStatus   @default(PROSPECT)
  ownershipStructure OwnershipStructure?
  syntheticAgent     Boolean             @default(false)
  listedByAgent      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String
  coOwners           String[]
  entityName         String?
  entityType         String?
  lastSyncedAt       DateTime?
  marketSyncedAt     DateTime?
  rentSyncedAt       DateTime?
  valueSyncedAt      DateTime?
  currentPhase       Int                 @default(1)
  dispositionType    String?
  subStrategy        String?
  holdHorizon        Int?
  exitAssumption     String?
  entryStage         String?
  lastActiveStage    String?
  overrideReason     String?
  propertyType       String?
  units              Int?
  condition          String?
  retrospective      Boolean             @default(false)
  // AQ-5 Source Card
  leadSource         String?
  listingUrl         String?
  askingPriceCents   BigInt?
  subjectDom         Int?
  leadAgent          String?
  dateIdentified     DateTime?

  // AQ-5 Seller Card
  sellerName       String?
  sellerType       String?
  sellerMotivation String?
  sellerContact    String?

  // AQ-5 Market Card
  submarket             String?
  medianSalesPriceCents BigInt?
  medianRentCents       BigInt?
  marketVacancyRate     Float?
  hazardFlag            Boolean @default(false)
  hazardNote            String?

  // AQ-6 First-Pass Screen
  firstPassRentCents BigInt?
  firstPassVerdict   String?

  // AQ-7 Comps & ARV
  arvCents              BigInt?
  fieldAssignments      FieldAssignment[]
  collaborators         ProjectCollaborator[]
  comps                 ReilComp[]
  createdBy             AppUser                 @relation(fields: [createdById], references: [id])
  propertyFacts         ReilPropertyFacts?
  purchaseTerms         ReilPurchaseTerms?
  valuationSnapshots    ReilValuationSnapshot[]
  statusEvents          StatusEvent[]
  fundingPlan           ReilFundingPlan?
  equityParties         ReilEquityParty[]
  loans                 ReilLoanRecord[]
  contributions         ReilContributionEntry[]
  closingMilestones     ReilClosingMilestone[]
  // New financial layer relations
  plaidConnections      PlaidConnection[]
  plaidLiabilities      PlaidLiability[]
  financialTransactions FinancialTransaction[]
  transactionRules      TransactionRule[]
  reconciliationPeriods ReconciliationPeriod[]

  @@index([createdById])
  @@index([acquisitionStatus])
  @@index([createdById, currentPhase])
  @@index([createdById, acquisitionStatus])
}

model ReilPropertyFacts {
  id                              String      @id @default(uuid())
  projectId                       String      @unique
  apn                             String?
  photoUrl                        String?
  beds                            Int?
  baths                           Float?
  sqft                            Int?
  yearBuilt                       Int?
  lotSqft                         Int?
  propertyType                    String?
  listPriceCents                  BigInt?
  estRentCents                    BigInt?
  lastSoldPriceCents              BigInt?
  lastSoldDate                    DateTime?
  sourceProvider                  String?
  fetchedAt                       DateTime?
  annualPropertyTaxCents          BigInt?
  hoaMonthlyCents                 BigInt?
  taxAssessedValueCents           BigInt?
  taxSource                       String?
  taxYear                         Int?
  avmPriceCents                   BigInt?
  avmPriceHighCents               BigInt?
  avmPriceLowCents                BigInt?
  estRentHighCents                BigInt?
  estRentLowCents                 BigInt?
  taxAssessedImprovementsValCents BigInt?
  taxAssessedLandValCents         BigInt?
  project                         ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ReilComp {
  id             String      @id @default(uuid())
  projectId      String
  addressLine    String
  soldPriceCents BigInt?
  soldDate       DateTime?
  beds           Int?
  baths          Float?
  sqft           Int?
  distanceMiles  Float?
  compType       String      @default("SALE")
  correlation    Float?
  daysOnMarket   Int?
  listedDate     DateTime?
  priceCents     BigInt?
  status         String?
  condition      String?
  project        ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ReilValuationSnapshot {
  id             String      @id @default(uuid())
  projectId      String
  valueCents     BigInt
  valueLowCents  BigInt
  valueHighCents BigInt
  source         String
  fetchedAt      DateTime
  createdAt      DateTime    @default(now())
  project        ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, fetchedAt])
}

model ReilPurchaseTerms {
  id                   String         @id @default(uuid())
  projectId            String         @unique
  offerMadeCents       BigInt?
  offerDate            DateTime?
  sellerResponse       SellerResponse @default(PENDING)
  counterPriceCents    BigInt?
  acceptedPriceCents   BigInt?
  earnestMoneyCents    BigInt?
  estClosingCostsCents BigInt?
  amountPaidCents      BigInt?
  project              ReilProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StatusEvent {
  id           String            @id @default(uuid())
  projectId    String
  status       AcquisitionStatus
  note         String?
  occurredAt   DateTime          @default(now())
  recordedById String
  project      ReilProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy   AppUser           @relation(fields: [recordedById], references: [id])

  @@index([projectId])
}

model ProjectCollaborator {
  id         String      @id @default(uuid())
  projectId  String
  userId     String
  role       MemberRole  @default(VIEWER)
  invitedAt  DateTime    @default(now())
  acceptedAt DateTime?
  project    ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       AppUser     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model FieldAssignment {
  id           String      @id @default(uuid())
  projectId    String
  fieldKey     String
  assignedToId String
  assignedById String
  status       FieldStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  assignedBy   AppUser     @relation("FieldAssignedBy", fields: [assignedById], references: [id])
  assignedTo   AppUser     @relation("FieldAssignedTo", fields: [assignedToId], references: [id])
  project      ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assignedToId])
}

enum AcquisitionStatus {
  PROSPECT
  UNDERWRITING
  OFFER_MADE
  UNDER_CONTRACT
  DUE_DILIGENCE
  CLEAR_TO_CLOSE
  CLOSED
  DEAD
  PRE_POSSESSION
  OWNED
}

enum OwnershipStructure {
  SOLE_OWNER
  JOINT_VENTURE
  LLC
  LP
  TRUST
  SYNDICATION
  SOLE_SEVERALTY
  JOINT_TENANCY
  TENANCY_IN_COMMON
  TENANCY_BY_ENTIRETY
  COMMUNITY_PROPERTY
  ENTITY
}

enum MemberRole {
  OWNER
  PARTNER
  ANALYST
  VIEWER
}

enum SellerResponse {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
}

enum FieldStatus {
  OPEN
  FILLED
}

model ReilFundingPlan {
  id            String              @id @default(uuid())
  projectId     String              @unique
  modality      String[] // e.g. ["solo_cash", "conventional_mortgage"]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  project       ReilProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sources       ReilCapitalSource[]
  titleHolding  ReilTitleHolding?
  closingRecord ReilClosingRecord?
}

model ReilCapitalSource {
  id            String          @id @default(uuid())
  fundingPlanId String
  type          String // solo_cash | co_buyer_equity | syndication_equity | conventional_loan | hard_money | bridge | sba_504_bank | sba_504_cdc | sba_504_injection
  amountCents   BigInt
  status        String // e.g. "projected", "confirmed", "verified"
  seniority     Int // e.g. 1 (senior debt), 2 (junior debt), 3 (equity)
  fundingPlan   ReilFundingPlan @relation(fields: [fundingPlanId], references: [id], onDelete: Cascade)

  @@index([fundingPlanId])
}

model ReilEquityParty {
  id           String      @id @default(uuid())
  projectId    String
  role         String // co_buyer | GP | LP
  name         String
  email        String?
  entityType   String // Individual or Entity
  memberId     String? // Link to AppUser.id or ProjectCollaborator
  ownershipPct Float       @default(0.0)
  project      ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ReilLoanRecord {
  id                  String      @id @default(uuid())
  projectId           String
  lenderName          String
  amountCents         BigInt
  interestRatePercent Float
  termMonths          Int
  points              Float       @default(0.0)
  status              String // e.g. "Estimate", "Locked"
  isInterestOnly      Boolean     @default(false)
  project             ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ReilContributionEntry {
  id             String      @id @default(uuid())
  projectId      String
  partyName      String
  email          String?
  amountCents    BigInt
  status         String // pledged | transferred | cleared | soft-committed | docs-out | signed | funds-confirmed
  evidenceDocId  String? // Link to Firestore document
  evidenceDocUrl String?
  partyType      String      @default("Investor") // LeadInvestor, Investor, Co-GP, Preferred Equity
  project        ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ReilTitleHolding {
  id              String          @id @default(uuid())
  fundingPlanId   String          @unique
  structure       String // TIC | JTWROS
  documentUrl     String?
  signatureStatus String          @default("unsigned")
  fundingPlan     ReilFundingPlan @relation(fields: [fundingPlanId], references: [id], onDelete: Cascade)
}

model ReilClosingMilestone {
  id               String      @id @default(uuid())
  projectId        String
  key              String // e.g. 'financing', 'title', 'appraisal'
  label            String
  targetOffsetDays Int
  targetDate       DateTime
  actualDate       DateTime?
  completed        Boolean     @default(false)
  notes            String?
  project          ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ReilClosingRecord {
  id               String          @id @default(uuid())
  fundingPlanId    String          @unique
  closingDate      DateTime?
  deedRecordedDate DateTime?
  instrumentNumber String?
  countyName       String?
  checklistState   String? // JSON string of executed docs checklist state
  fundingPlan      ReilFundingPlan @relation(fields: [fundingPlanId], references: [id], onDelete: Cascade)
}

// ── Phase 3: Hold Registry (HD-3 — canonical enums & models) ─────────────────
// Enums and models for the canonical Hold-phase variable registry.
// Primary persistence: Firestore `holdRegistry` sub-document.
// Prisma models here serve as the SQL reporting replica for financial analytics.

enum RenovationTier {
  STAGE // $ — cosmetic staging
  REFURBISH // $$ — light touch-up
  RENOVATE // $$$ — mid-range renovation
  GUT // $$$$ — full gut rehab
  DEVELOP // $$$$$ — ground-up or total rebuild
}

enum HoldExpenseCategory {
  tax
  insurance
  security
  maintenance
  utilities
  management
  HOA
  capex
}

enum OccupancyDuringHold {
  VACANT_FULL_REHAB
  OCCUPIED
  PARTIAL
}

enum UtilitiesResponsibility {
  LANDLORD
  TENANT
  SPLIT
}

/// Canonical Hold cost records — one row per category per project per period.
/// The eight canonical categories (SKILL.md Rule 8) are enforced by the enum.
model HoldCostRecord {
  id              String              @id @default(uuid())
  linkedProjectId String // References Firestore Project ID
  organizationId  String
  category        HoldExpenseCategory
  monthlyAmount   BigInt // cents
  periodMonth     String // YYYY-MM format
  sourceTag       String              @default("user_actual") // user_assumption | user_actual | document | derived | plaid
  carriedFromFund Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([linkedProjectId, category, periodMonth])
  @@index([linkedProjectId])
  @@index([organizationId])
  @@index([category])
}

/// Canonical renovation spend entries — each itemized capex/maintenance spend.
model HoldRehabSpend {
  id              String   @id @default(uuid())
  linkedProjectId String
  organizationId  String
  amount          BigInt // cents
  spendDate       DateTime
  category        String // 'capex' | 'maintenance' (guidance only, not a ninth expense tag)
  note            String
  vendorRef       String?
  receiptRef      String? // Firebase Storage reference
  sourceTag       String   @default("user_actual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([linkedProjectId])
  @@index([organizationId])
}

/// Current value dated series — tracks appreciation over the hold period.
model HoldValueEntry {
  id              String   @id @default(uuid())
  linkedProjectId String
  value           BigInt // cents
  valueDate       DateTime
  sourceTag       String   @default("user_assumption") // user_assumption | document
  documentRef     String? // appraisal/BPO reference

  createdAt DateTime @default(now())

  @@index([linkedProjectId])
  @@index([valueDate])
}

model BankConnection {
  id                  String              @id @default(uuid())
  userId              String
  projectId           String? // Optional: scopes this connection to a specific project
  accessToken         String // AES-256-GCM encrypted via tokenVault
  itemId              String?             @unique
  lastSyncCursor      String?
  lastSyncAt          DateTime?
  status              String              @default("active") // 'active' | 'paused' | 'error'
  connectionType      String              @default("rent_deposits") // 'rent_deposits' | 'operating_expenses'
  institutionName     String? // e.g. "Chase"
  institutionId       String? // Plaid institution_id
  accountId           String? // Denormalized from BankAccount for quick lookup
  accountName         String? // e.g. "Business Checking"
  accountMask         String? // e.g. "3847"
  webhookUrl          String? // URL registered with Plaid for this item
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  accounts            BankAccount[]
  transactions        Transaction[]
  mortgageLiabilities MortgageLiability[]

  @@index([userId])
  @@index([projectId])
  @@index([connectionType])
  @@index([userId, status])
}

model BankAccount {
  id             String         @id @default(uuid())
  plaidAccountId String         @unique
  connectionId   String
  name           String
  mask           String?
  officialName   String?
  type           String
  subtype        String?
  balance        BigInt         @default(0)
  limit          BigInt?
  currency       String         @default("USD")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  connection     BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([connectionId])
}

model Transaction {
  id             String         @id @default(uuid())
  plaidId        String         @unique
  connectionId   String
  accountId      String
  userId         String
  amount         BigInt // cents
  date           DateTime
  category       String[]
  merchantName   String?
  pending        Boolean        @default(false)
  reiCategory    String? // 'rental_income', 'debt_service', etc.
  confidence     Float? // 0.0 - 1.0
  projectId      String? // for auto-attribution
  reviewedByUser Boolean        @default(false)
  attributedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  connection     BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account        BankAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([date])
  @@index([reiCategory])
  @@index([plaidId])
  @@index([connectionId])
  @@index([userId, date])
  @@index([projectId, reiCategory])
}

model MortgageLiability {
  id                 String    @id @default(uuid())
  connectionId       String
  accountId          String // Plaid account_id of the mortgage account
  lender             String? // Institution / servicer name
  balance            BigInt // Current outstanding balance in cents
  originalBalance    BigInt? // Original loan balance in cents
  interestRatePct    Float? // e.g. 6.75
  apr                Float? // APR %
  nextPaymentDueDate DateTime? // Next payment due date
  nextPaymentAmount  BigInt? // Next payment amount in cents
  ytdInterestPaid    BigInt? // YTD interest paid in cents
  escrowBalance      BigInt? // Escrow balance in cents
  lastPaymentAmount  BigInt? // Last payment amount in cents
  lastPaymentDate    DateTime? // Last payment date
  fetchedAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  connection BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, accountId])
  @@index([connectionId])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAID DTM COMPLIANCE + UNIFIED FINANCIAL LAYER
// Added: 2026-07-29
// Spec: Plaid Data Transparency Messaging compliance, consent audit trail,
//       raw Plaid data storage, unified financial_transactions ledger,
//       categorization rule engine.
//
// IMPORTANT: All models below are ADDITIVE. Existing BankConnection,
// BankAccount, Transaction, and MortgageLiability models are preserved
// unchanged and continue to power the v1 sync pipeline.
//
// Entity references:
//   userId    → AppUser.id     (String @id, Firebase UID)
//   projectId → ReilProject.id (String @id @default(uuid()))
//   matchedLeaseId, matchedTenantId — nullable plain strings, no FK until
//   Lease/Tenant models are built.
// ─────────────────────────────────────────────────────────────────────────────

// ── Plaid Connection Enums ────────────────────────────────────────────────────

/// Purpose the user selected when linking this bank account via Plaid Link.
enum PlaidConnectionPurpose {
  RENT_COLLECTION
  OPERATING_EXPENSES
  MORTGAGE_LIABILITY
  RESERVE_ACCOUNT
  CAPX_ACCOUNT
}

/// Lifecycle status of a PlaidConnection item.
enum PlaidConnectionStatus {
  NOT_CONNECTED
  ACTIVE
  PENDING_AUTH
  ERROR
  DISCONNECTED
  EXPIRED
}

/// Types of DTM consent lifecycle events recorded in plaid_consent_events.
enum PlaidConsentEventType {
  INITIAL_CONSENT
  ADDITIONAL_CONSENT
  CONSENT_REVOKED
  CONSENT_UPDATED
}

// ── Liability Enums ───────────────────────────────────────────────────────────

/// Plaid /liabilities/get supported liability categories.
enum PlaidLiabilityType {
  MORTGAGE
  STUDENT_LOAN
  CREDIT_CARD
  AUTO_LOAN
  PERSONAL_LOAN
}

/// Interest rate structure for a loan liability.
enum LoanInterestRateType {
  FIXED
  VARIABLE
}

// ── Financial Transaction Enums ───────────────────────────────────────────────

/// Origin of a FinancialTransaction record.
enum FinancialTransactionSource {
  MANUAL
  PLAID_TRANSACTIONS
  PLAID_LIABILITIES
  IMPORT_CSV
  RULE_GENERATED
  RECONCILIATION_ADJUSTMENT
}

/// Money direction: CREDIT = money in, DEBIT = money out.
enum FinancialTransactionDirection {
  CREDIT
  DEBIT
}

/// Canonical 51-value category taxonomy.
/// Grouped into 6 P&L buckets — comments indicate the KPI impact of each bucket.
enum FinancialTransactionCategory {
  // ── REVENUE (Money IN) ─────────────────────────────────────────────────
  // Affects: Gross Rent, EGI, NOI, Cash Flow, Cash-on-Cash
  RENT_INCOME
  LATE_FEE_INCOME
  PET_RENT_INCOME
  PARKING_INCOME
  LAUNDRY_VENDING_INCOME
  APPLICATION_FEE_INCOME
  LEASE_TERMINATION_FEE
  UTILITY_REIMBURSEMENT
  INSURANCE_CLAIM_INCOME
  INTEREST_INCOME
  MISC_INCOME

  // ── OPERATING EXPENSES (Money OUT) ────────────────────────────────────
  // Affects: OpEx, NOI, Cash Flow, OER
  PROPERTY_TAX
  PROPERTY_INSURANCE
  HOA_FEES
  MANAGEMENT_FEES
  LEASING_FEES
  MAINTENANCE_REPAIR
  UTILITIES
  LANDSCAPING_SNOW
  PEST_CONTROL
  CLEANING_TURNOVER
  MARKETING_ADVERTISING
  LEGAL_PROFESSIONAL
  ACCOUNTING_BOOKKEEPING
  TRAVEL_MILEAGE
  BANK_CREDIT_CARD_FEES
  SOFTWARE_TECHNOLOGY
  LICENSES_PERMITS
  TURNOVER_COSTS
  SUPPLIES
  MISC_EXPENSE

  // ── MORTGAGE / DEBT SERVICE ───────────────────────────────────────────
  // Affects: Debt Service, DSCR, Cash Flow, Loan Balance
  MORTGAGE_PRINCIPAL
  MORTGAGE_INTEREST
  MORTGAGE_ESCROW_PAYMENT

  // ── CAPITAL EXPENDITURES ──────────────────────────────────────────────
  // Affects: CapEx Reserve, Equity — NOT OpEx or NOI
  CAPITAL_EXPENDITURE

  // ── TRANSFERS / NON-P&L ───────────────────────────────────────────────
  // Balance Sheet items — do not affect P&L
  SECURITY_DEPOSIT_RECEIVED
  SECURITY_DEPOSIT_RETURNED
  OWNER_DISTRIBUTION
  CAPITAL_CONTRIBUTION
  RESERVE_TRANSFER
  INTER_ACCOUNT_TRANSFER

  // ── UNCERTAIN ─────────────────────────────────────────────────────────
  UNCATEGORIZED
  NEEDS_REVIEW
}

/// IRS / tax accounting treatment for a financial transaction.
enum TaxTreatment {
  DEDUCTIBLE
  DEPRECIABLE
  NON_DEDUCTIBLE
  CAPITAL_IMPROVEMENT
  LIABILITY
}

/// Review workflow status of a FinancialTransaction.
enum FinancialTransactionStatus {
  DRAFT
  PENDING_REVIEW
  AUTO_APPROVED
  MANUALLY_APPROVED
  REJECTED
  ARCHIVED
}

// ── Transaction Rule Enums ────────────────────────────────────────────────────

/// Governs what the rule does when its conditions match.
enum TransactionRuleType {
  PLAID_AUTO_CATEGORIZE
  RECURRING_MANUAL_ENTRY
  REMINDER
}

/// How often a RECURRING_MANUAL_ENTRY rule generates a transaction.
enum TransactionRuleFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

/// Fields a rule condition can test against.
enum RuleConditionField {
  AMOUNT
  AMOUNT_RANGE
  PAYEE_NAME
  DESCRIPTION
  MERCHANT_NAME
  ACCOUNT_ID
  DATE_RANGE
  DAY_OF_MONTH
  TRANSACTION_TYPE
  PLAID_PERSONAL_FINANCE_CATEGORY
  PLAID_COUNTERPARTY_NAME
}

/// Comparison operators available in rule conditions.
enum RuleConditionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  STARTS_WITH
  ENDS_WITH
  REGEX_MATCH
  GREATER_THAN
  LESS_THAN
  BETWEEN
  IN_LIST
}

// ─────────────────────────────────────────────────────────────────────────────
// NEW MODELS
// ─────────────────────────────────────────────────────────────────────────────

/// DTM-aware Plaid connection — one per linked bank account.
/// Stores full consent metadata captured at Link time.
/// Intentionally separate from legacy BankConnection.
model PlaidConnection {
  id                          String                 @id @default(cuid())
  userId                      String
  projectId                   String?
  /// AES-256-GCM encrypted at the application layer via tokenVault. Never plaintext in DB.
  accessToken                 String
  itemId                      String                 @unique
  accountId                   String?
  institutionName             String?
  institutionId               String?
  institutionLogoUrl          String?
  accountName                 String?
  accountMask                 String?
  accountSubtype              String?
  connectionPurpose           PlaidConnectionPurpose @default(OPERATING_EXPENSES)
  status                      PlaidConnectionStatus  @default(NOT_CONNECTED)
  lastSyncCursor              String?
  lastSyncAt                  DateTime?
  lastSuccessfulSyncAt        DateTime?
  syncErrorCount              Int                    @default(0)
  lastSyncErrorMessage        String?
  webhookUrl                  String?
  /// JSON array of products the user consented to in Link DTM screen.
  consentedProducts           Json?
  /// JSON array of data scopes from the DTM screen.
  consentedDataScopes         Json?
  /// JSON array of use cases shown in Link.
  consentedUseCases           Json?
  /// Timestamp when user clicked "Allow" in Plaid Link.
  consentTimestamp            DateTime?
  /// DTM spec version at time of consent (e.g. "1.0").
  consentVersion              String?
  /// JSON array from Plaid's additional_consented_products field.
  additionalConsentedProducts Json?
  /// Plaid request ID captured on consent event
  requestId                   String?
  /// Plaid Link session ID captured on consent event
  linkSessionId               String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  user                  AppUser                @relation(fields: [userId], references: [id])
  project               ReilProject?           @relation(fields: [projectId], references: [id])
  consentEvents         PlaidConsentEvent[]
  rawTransactions       PlaidRawTransaction[]
  reconciliationPeriods ReconciliationPeriod[]
  liabilities           PlaidLiability[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([userId, status])
}

/// Immutable audit trail for every DTM consent state change.
/// NEVER update rows — insert only.
model PlaidConsentEvent {
  id                String                @id @default(cuid())
  plaidConnectionId String
  eventType         PlaidConsentEventType
  productsBefore    Json?
  productsAfter     Json?
  dataScopesBefore  Json?
  dataScopesAfter   Json?
  useCasesBefore    Json?
  useCasesAfter     Json?
  timestamp         DateTime              @default(now())
  /// AppUser.id of the human who triggered this, or literal "SYSTEM".
  triggeredBy       String
  /// From Plaid's /consent/events/get endpoint, if available.
  plaidEventId      String?
  /// Plaid request ID associated with consent event
  requestId         String?
  /// Plaid Link session ID associated with consent event
  linkSessionId     String?
  createdAt         DateTime              @default(now())

  connection PlaidConnection @relation(fields: [plaidConnectionId], references: [id], onDelete: Cascade)

  @@index([plaidConnectionId])
  @@index([plaidConnectionId, eventType])
  @@index([timestamp])
}

/// Write-only sink for raw Plaid transaction objects.
/// Reference-only — FinancialTransaction is the authoritative ledger.
model PlaidRawTransaction {
  id                      String                        @id @default(cuid())
  plaidConnectionId       String
  plaidTransactionId      String                        @unique
  plaidAccountId          String
  rawPlaidData            Json
  amount                  Decimal                       @db.Decimal(12, 2)
  isoCurrencyCode         String?                       @default("USD")
  direction               FinancialTransactionDirection
  name                    String
  merchantName            String?
  originalDescription     String?
  paymentChannel          String?
  pending                 Boolean                       @default(false)
  pendingTransactionId    String?
  authorizedDate          DateTime?
  postedDate              DateTime?
  category                String[]
  personalFinanceCategory Json?
  counterparties          Json?
  location                Json?
  paymentMeta             Json?
  removed                 Boolean                       @default(false)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  connection           PlaidConnection       @relation(fields: [plaidConnectionId], references: [id], onDelete: Cascade)
  financialTransaction FinancialTransaction?
  reconciliationItems  ReconciliationItem[]

  @@index([plaidConnectionId])
  @@index([plaidAccountId])
  @@index([postedDate])
  @@index([pending])
  @@index([removed])
  @@index([plaidConnectionId, postedDate])
}

/// Mortgage and loan liability data from Plaid /liabilities/get.
model PlaidLiability {
  id                         String                @id @default(cuid())
  plaidConnectionId          String
  projectId                  String?
  liabilityType              PlaidLiabilityType    @default(MORTGAGE)
  accountId                  String
  loanName                   String?
  loanType                   String?
  originationDate            DateTime?
  originationPrincipalAmount Decimal?              @db.Decimal(14, 2)
  interestRateType           LoanInterestRateType?
  apr                        Decimal?              @db.Decimal(6, 4)
  loanTermMonths             Int?
  maturityDate               DateTime?
  nextPaymentDueDate         DateTime?
  nextPaymentAmount          Decimal?              @db.Decimal(12, 2)
  lastPaymentDate            DateTime?
  lastPaymentAmount          Decimal?              @db.Decimal(12, 2)
  lastStatementBalance       Decimal?              @db.Decimal(14, 2)
  lastStatementIssueDate     DateTime?
  ytdInterestPaid            Decimal?              @db.Decimal(12, 2)
  ytdPrincipalPaid           Decimal?              @db.Decimal(12, 2)
  escrowBalance              Decimal?              @db.Decimal(12, 2)
  propertyAddress            Json?
  rawLiabilityData           Json
  lastFetchedAt              DateTime              @default(now())
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  connection            PlaidConnection        @relation(fields: [plaidConnectionId], references: [id], onDelete: Cascade)
  project               ReilProject?           @relation(fields: [projectId], references: [id])
  financialTransactions FinancialTransaction[]

  @@unique([plaidConnectionId, accountId])
  @@index([plaidConnectionId])
  @@index([projectId])
  @@index([liabilityType])
  @@index([nextPaymentDueDate])
}

/// Unified financial ledger — source of truth for all P&L calculations.
/// Plaid is optional: plaidTransactionId and plaidLiabilityId are both nullable.
model FinancialTransaction {
  id                           String                        @id @default(cuid())
  projectId                    String
  userId                       String
  source                       FinancialTransactionSource    @default(MANUAL)
  /// FK to PlaidRawTransaction — nullable, Plaid is not required.
  plaidTransactionId           String?                       @unique
  /// FK to PlaidLiability — nullable.
  plaidLiabilityId             String?
  amount                       Decimal                       @db.Decimal(12, 2)
  direction                    FinancialTransactionDirection
  transactionDate              DateTime
  postedDate                   DateTime?
  payee                        String
  description                  String?
  category                     FinancialTransactionCategory  @default(UNCATEGORIZED)
  subCategory                  String?
  /// Future FK: Lease.id — nullable string until Lease model is built.
  matchedLeaseId               String?
  /// Future FK: Tenant.id — nullable string until Tenant model is built.
  matchedTenantId              String?
  isRecurring                  Boolean                       @default(false)
  recurringRuleId              String?
  isSplit                      Boolean                       @default(false)
  parentTransactionId          String?
  taxTreatment                 TaxTreatment?
  receiptUrl                   String?
  notes                        String?
  status                       FinancialTransactionStatus    @default(DRAFT)
  confidenceScore              Float?
  reviewedBy                   String?
  reviewedAt                   DateTime?
  plaidPersonalFinanceCategory String?
  plaidPrimaryCategory         String?
  plaidDetailedCategory        String?
  /// JSON snapshot of KPI values at approval time — audit trail without re-running KPIs.
  kpiImpactSnapshot            Json?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  project             ReilProject            @relation(fields: [projectId], references: [id])
  user                AppUser                @relation(fields: [userId], references: [id])
  plaidTransaction    PlaidRawTransaction?   @relation(fields: [plaidTransactionId], references: [id])
  plaidLiability      PlaidLiability?        @relation(fields: [plaidLiabilityId], references: [id])
  reconciliationItems ReconciliationItem[]
  recurringRule       TransactionRule?       @relation(fields: [recurringRuleId], references: [id])
  parent              FinancialTransaction?  @relation("SplitChildren", fields: [parentTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children            FinancialTransaction[] @relation("SplitChildren")
  splits              TransactionSplit[]

  @@index([projectId])
  @@index([userId])
  @@index([source])
  @@index([category])
  @@index([status])
  @@index([transactionDate])
  @@index([projectId, transactionDate])
  @@index([projectId, category])
  @@index([projectId, status])
  @@index([matchedLeaseId])
  @@index([matchedTenantId])
  @@index([recurringRuleId])
  @@index([parentTransactionId])
}

/// Auto-categorization and recurring entry rules.
model TransactionRule {
  id            String                    @id @default(cuid())
  projectId     String
  userId        String
  name          String
  ruleType      TransactionRuleType
  frequency     TransactionRuleFrequency?
  startDate     DateTime?
  endDate       DateTime?
  /// JSON array: [{ "field": RuleConditionField, "operator": RuleConditionOperator, "value": any }]
  conditions    Json
  /// JSON: { category, subCategory, autoApprove, assignToLeaseId, taxTreatment,
  ///         generateTransaction, generateAmount, generatePayee, generateDescription }
  action        Json
  isActive      Boolean                   @default(true)
  /// Lower number = higher priority (evaluated first when multiple rules match).
  priority      Int                       @default(100)
  matchCount    Int                       @default(0)
  lastMatchedAt DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  project      ReilProject            @relation(fields: [projectId], references: [id])
  user         AppUser                @relation(fields: [userId], references: [id])
  transactions FinancialTransaction[]

  @@index([projectId])
  @@index([userId])
  @@index([isActive])
  @@index([projectId, isActive, priority])
}

/// Split-transaction line items. Parent FinancialTransaction.isSplit must be true.
model TransactionSplit {
  id                  String                       @id @default(cuid())
  parentTransactionId String
  amount              Decimal                      @db.Decimal(12, 2)
  category            FinancialTransactionCategory @default(UNCATEGORIZED)
  subCategory         String?
  matchedLeaseId      String?
  notes               String?
  createdAt           DateTime                     @default(now())

  parent FinancialTransaction @relation(fields: [parentTransactionId], references: [id], onDelete: Cascade)

  @@index([parentTransactionId])
}

/// Event log for all incoming Plaid webhook calls. Enables idempotency and replay debugging.
model PlaidWebhookEvent {
  id               String    @id @default(cuid())
  eventType        String
  itemId           String
  payload          Json
  processedAt      DateTime?
  processingResult String?
  errorMessage     String?
  createdAt        DateTime  @default(now())

  @@index([itemId])
  @@index([eventType])
  @@index([createdAt])
  @@index([itemId, eventType])
}

// ─── Transaction Notification Enums ──────────────────────────────────────────

/// Controls email delivery timing for transaction alerts.
enum EmailDigestMode {
  /// Send immediately when a transaction is approved.
  IMMEDIATE
  /// Batch and send once per hour.
  HOURLY_BATCH
  /// Include in the daily digest email only.
  DAILY_DIGEST
}

/// Controls which approvals trigger email alerts.
enum EmailAlertThreshold {
  /// Alert on all approved transactions.
  ALL
  /// Alert only when confidenceScore >= 0.85.
  HIGH_CONFIDENCE_ONLY
  /// Alert only on manually approved transactions (skip AUTO_APPROVED).
  MANUAL_APPROVAL_ONLY
}

// ─── User Notification Preferences ───────────────────────────────────────────

/// Per-user email alert preferences for the financial transaction notification layer.
/// One-to-one with AppUser. Created on first access with sensible defaults.
model UserNotificationPreferences {
  id                     String              @id @default(cuid())
  userId                 String              @unique
  /// Master switch — set false to disable all transaction email alerts.
  emailTransactionAlerts Boolean             @default(true)
  /// JSON array of FinancialTransactionCategory values the user wants alerts for.
  /// Stored as String[] for Prisma compatibility. Default: all 12 spec categories.
  emailAlertCategories   String[]
  /// Minimum absolute transaction amount (USD) that triggers an alert. Default 0 = alert on all.
  emailAlertMinAmount    Decimal             @default(0) @db.Decimal(12, 2)
  /// Controls email delivery timing.
  emailDigestMode        EmailDigestMode     @default(IMMEDIATE)
  /// Controls which approval types trigger alerts.
  emailAlertThreshold    EmailAlertThreshold @default(ALL)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Sent Email Log ───────────────────────────────────────────────────────────

/// Idempotency guard for transaction notification emails.
/// Unique on (transactionId, templateType) to prevent duplicate sends.
model SentEmailLog {
  id            String   @id @default(cuid())
  userId        String
  /// Nullable: null for digest/summary emails not tied to a single transaction.
  transactionId String?
  /// Template identifier, e.g. "RENT_PAYMENT_RECEIVED"
  templateType  String
  sentAt        DateTime @default(now())
  /// "sent" | "failed" | "mocked"
  status        String   @default("sent")
  /// Provider message ID from Resend.
  messageId     String?

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transactionId, templateType])
  @@index([userId])
  @@index([userId, sentAt])
  @@index([templateType])
}

// ─── Bank Reconciliation Enums ──────────────────────────────────────────────────

enum ReconciliationStatus {
  OPEN
  IN_PROGRESS
  RECONCILED
  DISCREPANCY_FOUND
}

enum ReconciliationItemType {
  BANK_ONLY
  PAPERWORKING_ONLY
  MATCHED
  DISCREPANCY
}

enum ReconciliationItemStatus {
  PENDING
  VERIFIED
  ADJUSTED
  IGNORED
}

// ─── Bank Reconciliation Models ────────────────────────────────────────────────

model ReconciliationPeriod {
  id                   String               @id @default(cuid())
  projectId            String
  plaidConnectionId    String?
  month                Int
  year                 Int
  status               ReconciliationStatus @default(OPEN)
  bankStatementBalance Decimal              @default(0) @db.Decimal(12, 2)
  paperWorkingBalance  Decimal              @default(0) @db.Decimal(12, 2)
  difference           Decimal              @default(0) @db.Decimal(12, 2)
  reconciledAt         DateTime?
  reconciledBy         String?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  project         ReilProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plaidConnection PlaidConnection?     @relation(fields: [plaidConnectionId], references: [id])
  reconciler      AppUser?             @relation(fields: [reconciledBy], references: [id])
  items           ReconciliationItem[]

  @@unique([projectId, month, year])
  @@index([projectId])
  @@index([plaidConnectionId])
  @@index([status])
}

model ReconciliationItem {
  id                     String                   @id @default(cuid())
  reconciliationPeriodId String
  financialTransactionId String?
  plaidTransactionId     String?
  itemType               ReconciliationItemType
  bankAmount             Decimal?                 @db.Decimal(12, 2)
  paperWorkingAmount     Decimal?                 @db.Decimal(12, 2)
  description            String
  date                   DateTime
  status                 ReconciliationItemStatus @default(PENDING)
  notes                  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  reconciliationPeriod ReconciliationPeriod  @relation(fields: [reconciliationPeriodId], references: [id], onDelete: Cascade)
  financialTransaction FinancialTransaction? @relation(fields: [financialTransactionId], references: [id])
  plaidTransaction     PlaidRawTransaction?  @relation(fields: [plaidTransactionId], references: [id])

  @@index([reconciliationPeriodId])
  @@index([financialTransactionId])
  @@index([plaidTransactionId])
  @@index([itemType])
  @@index([status])
}

model User {
  id               String                 @id @default(uuid())
  email            String                 @unique
  name             String?
  syntheticAgent   Boolean                @default(false)
  agentPersona     String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  projects         Project[]              @relation("UserProjects")
  investorProjects Project[]              @relation("InvestorProjects")
  subscriptions    Subscription[]
  messagesSent     Message[]              @relation("UserSentMessages")
  messagesRecv     Message[]              @relation("UserReceivedMessages")
  listings         MarketplaceListing[]
  dealsCreated     Deal[]
  dealInvitations  DealInvitation[]
  commitments      InvestmentCommitment[]
  dealMessages     DealMessage[]
  businessCard     BusinessCard?
  dealBroadcasts   DealBroadcast[]
}

model Project {
  id             String    @id @default(uuid())
  title          String?
  name           String?
  address        String?
  city           String?
  state          String?
  zip            String?
  status         String?   @default("active")
  syntheticAgent Boolean   @default(false)
  listedByAgent  String?
  userId         String?
  user           User?     @relation("UserProjects", fields: [userId], references: [id])
  investorId     String?
  investor       User?     @relation("InvestorProjects", fields: [investorId], references: [id])
  dealId         String?
  deal           Deal?     @relation(fields: [dealId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]
}

model MarketplaceListing {
  id             String   @id @default(uuid())
  title          String?
  syntheticAgent Boolean  @default(false)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Message {
  id                  String   @id @default(uuid())
  threadId            String
  senderId            String
  sender              User     @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId         String
  recipient           User     @relation("UserReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject             String
  body                String
  attachmentProjectId String?
  attachmentProject   Project? @relation(fields: [attachmentProjectId], references: [id], onDelete: SetNull)
  read                Boolean  @default(false)
  syntheticAgent      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([threadId])
  @@index([senderId])
  @@index([recipientId])
  @@index([attachmentProjectId])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id])
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 String?
  status               String?
  syntheticAgent       Boolean  @default(false)
  stripeTestMode       Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ── Deal & Crowdfunding Marketplace Entities ──────────────────────────────────

enum DealStatus {
  draft
  published
  funding
  closed
  archived
}

enum DealInvitationStatus {
  pending
  declined
  interested
}

enum InvestmentCommitmentCurrency {
  USD
  CAD
  EUR
  GBP
}

enum InvestmentCommitmentType {
  percentage
  fixed
}

enum InvestmentCommitmentStatus {
  pending
  confirmed
  withdrawn
}

enum DealMessageSource {
  platform
  email_inbound
}

enum DealVisibility {
  marketplace
  invitation_only
  private
}

model Deal {
  id            String                 @id @default(uuid())
  slug          String                 @unique
  address       String
  purchasePrice Decimal                @db.Decimal(14, 2)
  rehabCost     Decimal                @db.Decimal(14, 2)
  arv           Decimal                @db.Decimal(14, 2)
  holdingCosts  Decimal                @db.Decimal(14, 2)
  projectedRoi  Decimal                @db.Decimal(8, 4)
  status        DealStatus             @default(draft)
  visibility    DealVisibility         @default(private)
  creatorId     String
  creator       User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  projects      Project[]
  invitations   DealInvitation[]
  commitments   InvestmentCommitment[]
  broadcasts    DealBroadcast[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  dealMessages  DealMessage[]

  @@index([creatorId])
  @@index([status])
  @@index([visibility])
  @@index([slug])
}

model DealBroadcast {
  id                  String   @id @default(uuid())
  dealId              String
  deal                Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  senderId            String
  sender              User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recipientEmails     Json
  subject             String
  message             String
  includeBusinessCard Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@index([dealId])
  @@index([senderId])
}

model DealInvitation {
  id                 String               @id @default(uuid())
  dealId             String
  deal               Deal                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  inviteeEmail       String
  inviteeUserId      String?
  inviteeUser        User?                @relation(fields: [inviteeUserId], references: [id], onDelete: SetNull)
  status             DealInvitationStatus @default(pending)
  businessCardShared Boolean              @default(false)
  createdAt          DateTime             @default(now())

  @@index([dealId])
  @@index([inviteeEmail])
  @@index([status])
}

model InvestmentCommitment {
  id         String                       @id @default(uuid())
  dealId     String
  deal       Deal                         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  investorId String
  investor   User                         @relation(fields: [investorId], references: [id], onDelete: Cascade)
  amount     Decimal                      @db.Decimal(14, 2)
  currency   InvestmentCommitmentCurrency @default(USD)
  type       InvestmentCommitmentType     @default(fixed)
  status     InvestmentCommitmentStatus   @default(pending)
  createdAt  DateTime                     @default(now())

  @@index([dealId])
  @@index([investorId])
  @@index([status])
}

model DealMessage {
  id          String            @id @default(uuid())
  dealId      String
  deal        Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderEmail String
  content     String
  source      DealMessageSource @default(platform)
  createdAt   DateTime          @default(now())

  @@index([dealId])
  @@index([senderId])
}

model BusinessCard {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  email              String
  phone              String?
  company            String?
  investmentCriteria Json?
  isPublic           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([email])
}

model AdminAuditLog {
  id               String   @id @default(uuid())
  sequenceNumber   BigInt   @default(autoincrement())
  timestamp        DateTime @default(now())
  actorUid         String
  actorEmail       String
  actorRole        String
  action           String
  targetResource   String
  targetResourceId String?
  status           String // 'SUCCESS' | 'DENIED' | 'ERROR'
  ipAddress        String   @default("127.0.0.1")
  userAgent        String?
  reasonCode       String?
  severity         String   @default("info") // 'info' | 'warning' | 'critical'
  previousHash     String   @default("GENESIS")
  entryHash        String
  metadata         Json?

  @@index([timestamp])
  @@index([actorUid])
  @@index([action])
  @@index([severity])
  @@index([sequenceNumber])
}
