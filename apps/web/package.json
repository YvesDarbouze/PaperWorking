{
  "name": "@paperworking/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Migrated web app (Next.js) — full App Router surface",
  "scripts": {
    "dev": "node --env-file=../../.env --env-file=.env.local ../../node_modules/next/dist/bin/next dev",
    "build": "next build",
    "vercel-build": "cd ../.. && npm run build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.10",
    "@opentelemetry/api": "^1.9.1",
    "@paperworking/api": "file:../api",
    "@paperworking/authz": "file:../../packages/authz",
    "@paperworking/database": "file:../../packages/database",
    "@paperworking/financial-engine": "file:../../packages/financial-engine",
    "@paperworking/identity": "file:../../packages/identity",
    "@paperworking/services": "file:../../packages/services",
    "@paperworking/shared": "file:../../packages/shared",
    "@paperworking/validation": "file:../../packages/validation",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.66.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.8.3"
  }
}
