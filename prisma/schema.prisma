// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Epic 2: Deep Financial Reporting Models ──────────────────

model DealFinancials {
  id                String   @id @default(uuid())
  organizationId    String
  linkedDealId      String?  @unique // Reference to Firestore Project ID

  // Stored in Cents (BigInt for institutional scale)
  purchasePrice     BigInt   @default(0)
  salePrice         BigInt   @default(0)
  closingCosts      BigInt   @default(0)
  renovationCosts   BigInt   @default(0)
  holdingCosts      BigInt   @default(0)

  // Payee Waterfall summary
  totalPayouts      BigInt   @default(0)

  // Project lifecycle spine fields
  strategyType         String?
  targetPurchasePrice  BigInt?
  capitalRaiseTarget    BigInt?
  committedCapital     BigInt?
  actualRehabCost      BigInt?
  actualRentalIncome   BigInt?
  daysOccupied         Int?
  totalHoldDays         Int?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payouts           PayoutWaterfall[]

  @@index([organizationId])
}

model PayoutWaterfall {
  id                String   @id @default(uuid())
  financialsId      String
  payeeName         String
  payeeRole         String   // e.g. 'Equity Partner', 'Lender', 'Agent', 'Contractor'
  payoutAmount      BigInt   // cents
  isConfirmed       Boolean  @default(false)
  
  // Link back to Firestore LedgerItem
  linkedItemId      String?  @unique
  status            String   @default("Pending") // Pending, Approved, Rejected
  
  createdAt         DateTime @default(now())
  
  financials        DealFinancials @relation(fields: [financialsId], references: [id], onDelete: Cascade)

  @@index([financialsId])
}

model PhaseTransition {
  id                String   @id @default(uuid())
  linkedProjectId   String
  fromPhase         String
  toPhase           String
  transitionDate    DateTime @default(now())
  userUid           String
  notes             String?
  
  @@index([linkedProjectId])
}

// ── Phase 4: Communication Models ────────────────────────────

model CommunicationLog {
  id                String   @id @default(uuid())
  linkedProjectId   String
  organizationId    String
  
  type              String   // 'EMAIL_INBOUND' | 'EMAIL_OUTBOUND' | 'INTERNAL_COMMENT'
  direction         String   // 'IN' | 'OUT'
  
  fromAddress       String
  toAddress         String
  subject           String?
  body              String
  
  providerMessageId String?  @unique // SendGrid/Postmark ID
  threadId          String?  // Logical grouping for UI
  
  createdAt         DateTime @default(now())
  
  @@index([linkedProjectId])
  @@index([organizationId])
  @@index([threadId])
}

/// Per-recipient delivery tracking for transactional emails.
/// Updated by Resend webhook events (Sent → Delivered → Opened → Clicked).
model EmailLog {
  id                String    @id @default(uuid())
  organizationId    String
  recipientId       String?   // Firebase UID of the recipient (null for external)
  recipientEmail    String
  messageId         String    // Resend provider message ID
  templateSlug      String    // e.g. 'phase_advance', 'investor_pledge', 'user_composed'
  linkedProjectId   String?   // Firestore project ID for deal context
  status            String    @default("Sent") // Sent | Delivered | Opened | Clicked | Bounced | Failed
  subject           String?
  sentAt            DateTime  @default(now())
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  errorMessage      String?
  metadata          String?   // JSON: extra context (merge vars, campaign tags, etc.)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId])
  @@index([recipientEmail])
  @@index([messageId])
  @@index([templateSlug])
  @@index([status])
  @@index([linkedProjectId])
}

// ── Bridge API Models ────────────────────────────────────────

model Property {
  id                    String   @id @default(uuid())
  listingKey            String   @unique
  listingId             String   @unique
  
  standardStatus        String?
  listPrice             BigInt?  // cents
  unparsedAddress       String?
  
  // Final Formula Requirements
  bedroomsTotal         Int?
  bathroomsFull         Int?
  bathroomsHalf         Int?
  livingArea            Int?
  lotSizeAcres          Float?
  yearBuilt             Int?
  publicRemarks         String?
  media                 String?  // JSON stringified Media array
  
  bridgeModificationTimestamp DateTime
  
  // Geospatial data (stored as string for SQLite compatibility)
  coordinates           String?  // format: "POINT(lon lat)"
  
  // Licensing & Provenance
  feedTypes             String?  // JSON stringified array ["IDX", "VOW"]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([standardStatus])
  @@index([bridgeModificationTimestamp])
}

model BridgeSyncState {
  id                               String   @id // e.g. "replication_watermark", "member_watermark", "office_watermark"
  mostRecentModificationTimestamp  DateTime
  updatedAt                        DateTime @updatedAt
}

// ── Cached MLS Member (Agent) ────────────────────────────────
// Populated by the Member replication worker from Bridge /Member.
// Keeps a local copy for fast search + directory rendering without
// hitting the Bridge API on every frontend request.

model Member {
  id                  String   @id @default(uuid())
  memberKey           String   @unique
  memberMlsId         String?
  memberFullName      String?
  memberFirstName     String?
  memberLastName      String?
  memberEmail         String?
  memberDirectPhone   String?
  memberMobilePhone   String?
  memberStateLicense  String?
  memberDesignation   String?  // JSON array
  officeName          String?
  officeKey           String?
  officeMlsId         String?
  media               String?  // JSON stringified Media array
  modificationTimestamp DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([memberFullName])
  @@index([officeKey])
  @@index([modificationTimestamp])
}

// ── Cached MLS Office ────────────────────────────────────────
// Populated by the Office replication worker from Bridge /Office.

model Office {
  id                      String   @id @default(uuid())
  officeKey               String   @unique
  officeMlsId             String?
  officeName              String?
  officePhone             String?
  officeEmail             String?
  officeAddress1          String?
  officeCity              String?
  officeStateOrProvince   String?
  officePostalCode        String?
  officeType              String?
  officeStatus            String?
  modificationTimestamp   DateTime?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([officeName])
  @@index([modificationTimestamp])
}

// ── Async Job Queue Audit Log ────────────────────────────────
// Records the lifecycle of every job that passes through the
// Redis queue for observability and DLQ investigation.
// Additive migration — no existing columns modified.

model JobRecord {
  id          String    @id // matches jobQueue.Job.id
  type        String    // 'bridge_sync' | 'member_sync' | 'office_sync' | 'webhook_process'
  status      String    @default("pending") // pending | processing | done | failed | dlq
  payload     String    // JSON
  attempts    Int       @default(0)
  error       String?
  enqueuedAt  DateTime
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([type, status])
  @@index([enqueuedAt])
}

// ── Phase 1: Sourcing Models ──────────────────────────────────

model SourcingLead {
  id                String   @id @default(uuid())
  organizationId    String
  
  // Webhook / Integration origin
  sourceVendor      String   // e.g. "PropStream", "Manual"
  sourceReferenceId String?  // ID from vendor system
  
  // Property Metadata
  address           String
  city              String?
  state             String?
  zipCode           String?
  propertyType      String?
  estimatedValue    BigInt?
  
  // Owner Details
  ownerName         String?
  ownerContact      String?  // JSON or string
  
  // R0: Versioning
  criteriaVersion   String   @default("v1")
  
  // R0: Dual-Scope Metrics
  costPerLead       BigInt?  // Operational metric (cents)
  estimatedMargin   BigInt?  // Financial metric (cents)
  
  // R0: Ownership %
  ownershipShares   Json?  // JSON mapping userId -> percentage
  
  status            String   @default("New") // New, Qualified, Rejected, Converted
  convertedProjectId String? // Link to actual deal/project if converted
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([organizationId])
  @@index([status])
  @@index([sourceVendor])
}

// ── Phase 3: Rehab Models ────────────────────────────────────

model RehabProject {
  id                String   @id @default(uuid())
  linkedProjectId   String   @unique // Link to the central Deal/Project
  organizationId    String
  
  status            String   @default("Planning") // Planning, Bidding, In Progress, Completed, On Hold
  
  // Budget tracking
  estimatedBudget   BigInt   @default(0) // cents
  actualCost        BigInt   @default(0) // cents
  
  // Timeline
  startDate         DateTime?
  endDate           DateTime?
  
  // R0 constraints
  ownershipShares   Json?  // JSON mapping userId -> percentage
  criteriaVersion   String   @default("v1")
  
  // Relations
  milestones        RehabMilestone[]
  changeOrders      ChangeOrder[]
  documents         RehabDocument[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model RehabMilestone {
  id                String   @id @default(uuid())
  rehabProjectId    String
  title             String
  description       String?
  status            String   @default("Pending") // Pending, In Progress, Completed
  
  estimatedCost     BigInt   @default(0) // cents
  actualCost        BigInt   @default(0) // cents
  
  startDate         DateTime?
  endDate           DateTime?
  
  rehabProject      RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)
  bids              VendorBid[]
  invoices          RehabInvoice[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([rehabProjectId])
}

model Vendor {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  type              String   // GC, Plumber, Electrician, etc.
  contactEmail      String?
  contactPhone      String?
  
  bids              VendorBid[]
  invoices          RehabInvoice[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
}

model VendorBid {
  id                String   @id @default(uuid())
  vendorId          String
  milestoneId       String
  
  bidAmount         BigInt   // cents
  status            String   @default("Pending") // Pending, Accepted, Rejected
  notes             String?
  
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  milestone         RehabMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([vendorId])
  @@index([milestoneId])
}

model RehabInvoice {
  id                String   @id @default(uuid())
  vendorId          String
  milestoneId       String
  
  amount            BigInt   // cents
  status            String   @default("Pending") // Pending, Approved, Paid
  documentUrl       String?
  
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  milestone         RehabMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([vendorId])
  @@index([milestoneId])
}

model ChangeOrder {
  id                String   @id @default(uuid())
  rehabProjectId    String
  
  description       String
  requestedCost     BigInt   // cents
  approvedCost      BigInt?  // cents
  status            String   @default("Pending") // Pending, Approved, Rejected
  
  rehabProject      RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([rehabProjectId])
}

model RehabDocument {
  id                String   @id @default(uuid())
  rehabProjectId    String
  
  title             String
  type              String   // Permit, Inspection, Plan, Invoice
  fileUrl           String
  
  rehabProject      RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  
  @@index([rehabProjectId])
}

// ── REIL Acquisition Models ───────────────────────────────────────────────────
// These models back the Create-Project wizard and the full acquisition pipeline.
// Separate from the Firestore-based Project; co-exists in the Neon DB alongside
// DealFinancials and the MLS bridge models above.

enum AcquisitionStatus {
  PROSPECT
  OFFER_MADE
  UNDER_CONTRACT
  DUE_DILIGENCE
  CLEAR_TO_CLOSE
  PRE_POSSESSION
  OWNED
  // Legacy values — kept for backward compat with existing rows
  UNDERWRITING
  CLOSED
  DEAD
}

enum OwnershipStructure {
  SOLE_SEVERALTY
  JOINT_TENANCY
  TENANCY_IN_COMMON
  TENANCY_BY_ENTIRETY
  COMMUNITY_PROPERTY
  ENTITY
  // Legacy values — kept for backward compat
  SOLE_OWNER
  JOINT_VENTURE
  LLC
  LP
  TRUST
  SYNDICATION
}

enum MemberRole {
  OWNER
  PARTNER
  ANALYST
  VIEWER
}

enum SellerResponse {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
}

enum FieldStatus {
  OPEN
  FILLED
}

model AppUser {
  id         String   @id  // Firebase UID
  email      String   @unique
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  projects         ReilProject[]
  collaborations   ProjectCollaborator[]
  fieldAssignedTo  FieldAssignment[]    @relation("FieldAssignedTo")
  fieldAssignedBy  FieldAssignment[]    @relation("FieldAssignedBy")
  statusEvents     StatusEvent[]
}

model ReilProject {
  id                 String              @id @default(uuid())
  addressLine        String              @default("")
  city               String              @default("")
  state              String              @default("")
  zip                String              @default("")
  lat                Float?
  lng                Float?
  placeId            String?
  displayName        String?
  acquisitionStatus  AcquisitionStatus   @default(PROSPECT)
  ownershipStructure OwnershipStructure?
  entityType         String?   // e.g. "LLC", "Trust", "Corporation" — set when ENTITY selected
  entityName         String?   // name of the holding entity
  coOwners           String[]  // free-text co-owner names (linked to Members in a later phase)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String
  lastSyncedAt       DateTime?
  valueSyncedAt      DateTime?
  rentSyncedAt       DateTime?
  marketSyncedAt     DateTime?

  createdBy       AppUser               @relation(fields: [createdById], references: [id])
  propertyFacts   ReilPropertyFacts?
  comps           ReilComp[]
  purchaseTerms   ReilPurchaseTerms?
  statusEvents    StatusEvent[]
  collaborators   ProjectCollaborator[]
  fieldAssignments FieldAssignment[]
  valuationSnapshots ReilValuationSnapshot[]

  @@index([createdById])
  @@index([acquisitionStatus])
}

model ReilPropertyFacts {
  id                      String      @id @default(uuid())
  projectId               String      @unique
  photoUrl                String?
  beds                    Int?
  baths                   Float?
  sqft                    Int?
  yearBuilt               Int?
  lotSqft                 Int?
  propertyType            String?
  listPriceCents          BigInt?
  estRentCents            BigInt?
  lastSoldPriceCents      BigInt?
  lastSoldDate            DateTime?
  // ── Tax & HOA (Prompt 2) ───────────────────────────────────
  annualPropertyTaxCents  BigInt?     // Most recent annual property tax (cents)
  taxAssessedValueCents   BigInt?     // Most recent assessed value (cents)
  taxAssessedLandValCents  BigInt?     // Assessed land value (cents)
  taxAssessedImprovementsValCents BigInt?     // Assessed improvements value (cents)
  taxYear                 Int?        // Year of the tax/assessment figure
  hoaMonthlyCents         BigInt?     // Monthly HOA fee (cents)
  taxSource               String?     // e.g. 'rentcast' — provenance label
  // ── Rent AVM (Prompt 3) ────────────────────────────────────
  estRentLowCents         BigInt?     // Rent estimate low bound
  estRentHighCents        BigInt?     // Rent estimate high bound
  // ── Value AVM (Prompt 4) ───────────────────────────────────
  avmPriceCents           BigInt?     // AVM value estimate
  avmPriceLowCents        BigInt?     // AVM value estimate low bound
  avmPriceHighCents       BigInt?     // AVM value estimate high bound
  // ── Meta ───────────────────────────────────────────────────
  sourceProvider          String?
  fetchedAt               DateTime?

  project ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ReilComp {
  id             String      @id @default(uuid())
  projectId      String
  addressLine    String
  soldPriceCents BigInt?
  soldDate       DateTime?
  beds           Int?
  baths          Float?
  sqft           Int?
  distanceMiles  Float?
  // ── Rent & Value comps additions (Prompts 3 & 4) ───────────
  compType       String      @default("SALE") // "SALE" or "RENTAL"
  priceCents     BigInt?     // Unified price (rent or sale price)
  correlation    Float?      // 0-1 similarity score from RentCast
  daysOnMarket   Int?        // DOM
  status         String?     // e.g. "Sold", "Active", "Rented"
  listedDate     DateTime?   // When listed

  project ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ReilValuationSnapshot {
  id              String   @id @default(uuid())
  projectId       String
  valueCents      BigInt       // AVM point estimate
  valueLowCents   BigInt       // Range low
  valueHighCents  BigInt       // Range high
  source          String       // "rentcast"
  fetchedAt       DateTime     // When the AVM was fetched
  createdAt       DateTime @default(now())

  project ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, fetchedAt])
}

model ReilPurchaseTerms {
  id                   String         @id @default(uuid())
  projectId            String         @unique
  offerMadeCents       BigInt?
  offerDate            DateTime?
  sellerResponse       SellerResponse @default(PENDING)
  counterPriceCents    BigInt?
  acceptedPriceCents   BigInt?
  earnestMoneyCents    BigInt?
  estClosingCostsCents BigInt?
  amountPaidCents      BigInt?

  project ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StatusEvent {
  id           String            @id @default(uuid())
  projectId    String
  status       AcquisitionStatus
  note         String?
  occurredAt   DateTime          @default(now())
  recordedById String

  project    ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy AppUser     @relation(fields: [recordedById], references: [id])

  @@index([projectId])
}

model ProjectCollaborator {
  id         String     @id @default(uuid())
  projectId  String
  userId     String
  role       MemberRole @default(VIEWER)
  invitedAt  DateTime   @default(now())
  acceptedAt DateTime?

  project ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    AppUser     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model FieldAssignment {
  id           String      @id @default(uuid())
  projectId    String
  fieldKey     String
  assignedToId String
  assignedById String
  status       FieldStatus @default(OPEN)
  createdAt    DateTime    @default(now())

  project    ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo AppUser     @relation("FieldAssignedTo", fields: [assignedToId], references: [id])
  assignedBy AppUser     @relation("FieldAssignedBy", fields: [assignedById], references: [id])

  @@index([projectId])
  @@index([assignedToId])
}

// ── Phase 3: Hold Registry (HD-3 — canonical enums & models) ─────────────────
// Enums and models for the canonical Hold-phase variable registry.
// Primary persistence: Firestore `holdRegistry` sub-document.
// Prisma models here serve as the SQL reporting replica for financial analytics.

enum RenovationTier {
  STAGE       // $ — cosmetic staging
  REFURBISH   // $$ — light touch-up
  RENOVATE    // $$$ — mid-range renovation
  GUT         // $$$$ — full gut rehab
  DEVELOP     // $$$$$ — ground-up or total rebuild
}

enum HoldExpenseCategory {
  tax
  insurance
  security
  maintenance
  utilities
  management
  HOA
  capex
}

enum OccupancyDuringHold {
  VACANT_FULL_REHAB
  OCCUPIED
  PARTIAL
}

enum UtilitiesResponsibility {
  LANDLORD
  TENANT
  SPLIT
}

/// Canonical Hold cost records — one row per category per project per period.
/// The eight canonical categories (SKILL.md Rule 8) are enforced by the enum.
model HoldCostRecord {
  id              String              @id @default(uuid())
  linkedProjectId String              // References Firestore Project ID
  organizationId  String
  category        HoldExpenseCategory
  monthlyAmount   BigInt              // cents
  periodMonth     String              // YYYY-MM format
  sourceTag       String              @default("user_actual") // user_assumption | user_actual | document | derived | plaid
  carriedFromFund Boolean             @default(false)
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([linkedProjectId, category, periodMonth])
  @@index([linkedProjectId])
  @@index([organizationId])
  @@index([category])
}

/// Canonical renovation spend entries — each itemized capex/maintenance spend.
model HoldRehabSpend {
  id              String    @id @default(uuid())
  linkedProjectId String
  organizationId  String
  amount          BigInt    // cents
  spendDate       DateTime
  category        String    // 'capex' | 'maintenance' (guidance only, not a ninth expense tag)
  note            String
  vendorRef       String?
  receiptRef      String?   // Firebase Storage reference
  sourceTag       String    @default("user_actual")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([linkedProjectId])
  @@index([organizationId])
}

/// Current value dated series — tracks appreciation over the hold period.
model HoldValueEntry {
  id              String    @id @default(uuid())
  linkedProjectId String
  value           BigInt    // cents
  valueDate       DateTime
  sourceTag       String    @default("user_assumption") // user_assumption | document
  documentRef     String?   // appraisal/BPO reference
  
  createdAt       DateTime  @default(now())

  @@index([linkedProjectId])
  @@index([valueDate])
}
