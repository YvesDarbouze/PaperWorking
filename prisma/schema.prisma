generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DealFinancials {
  id                  String            @id @default(uuid())
  organizationId      String
  linkedDealId        String?           @unique
  purchasePrice       BigInt            @default(0)
  salePrice           BigInt            @default(0)
  closingCosts        BigInt            @default(0)
  renovationCosts     BigInt            @default(0)
  holdingCosts        BigInt            @default(0)
  totalPayouts        BigInt            @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  actualRehabCost     BigInt?
  actualRentalIncome  BigInt?
  capitalRaiseTarget  BigInt?
  committedCapital    BigInt?
  daysOccupied        Int?
  targetPurchasePrice BigInt?
  totalHoldDays       Int?
  payouts             PayoutWaterfall[]

  @@index([organizationId])
}

model PayoutWaterfall {
  id           String         @id @default(uuid())
  financialsId String
  payeeName    String
  payeeRole    String
  payoutAmount BigInt
  isConfirmed  Boolean        @default(false)
  linkedItemId String?        @unique
  status       String         @default("Pending")
  createdAt    DateTime       @default(now())
  financials   DealFinancials @relation(fields: [financialsId], references: [id], onDelete: Cascade)

  @@index([financialsId])
}

model PhaseTransition {
  id              String   @id @default(uuid())
  linkedProjectId String
  fromPhase       String
  toPhase         String
  transitionDate  DateTime @default(now())
  userUid         String
  notes           String?

  @@index([linkedProjectId])
}

model CommunicationLog {
  id                String   @id @default(uuid())
  linkedProjectId   String
  organizationId    String
  type              String
  direction         String
  fromAddress       String
  toAddress         String
  subject           String?
  body              String
  threadId          String?
  createdAt         DateTime @default(now())
  providerMessageId String?  @unique

  @@index([linkedProjectId])
  @@index([organizationId])
  @@index([threadId])
}

/// Per-recipient delivery tracking for transactional emails.
/// Updated by Resend webhook events (Sent → Delivered → Opened → Clicked).
model EmailLog {
  id              String    @id @default(uuid())
  organizationId  String
  recipientId     String?
  recipientEmail  String
  templateSlug    String
  linkedProjectId String?
  status          String    @default("Sent")
  subject         String?
  sentAt          DateTime  @default(now())
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  errorMessage    String?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messageId       String

  @@index([organizationId])
  @@index([recipientEmail])
  @@index([messageId])
  @@index([templateSlug])
  @@index([status])
  @@index([linkedProjectId])
}

model Property {
  id                          String   @id @default(uuid())
  listingKey                  String   @unique
  listingId                   String   @unique
  standardStatus              String?
  listPrice                   BigInt?
  unparsedAddress             String?
  bedroomsTotal               Int?
  bathroomsFull               Int?
  bathroomsHalf               Int?
  livingArea                  Int?
  lotSizeAcres                Float?
  yearBuilt                   Int?
  publicRemarks               String?
  media                       String?
  bridgeModificationTimestamp DateTime
  coordinates                 String?
  feedTypes                   String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([standardStatus])
  @@index([bridgeModificationTimestamp])
}

model BridgeSyncState {
  id                              String   @id
  mostRecentModificationTimestamp DateTime
  updatedAt                       DateTime @updatedAt
}

model Member {
  id                    String    @id @default(uuid())
  memberKey             String    @unique
  memberMlsId           String?
  memberFullName        String?
  memberFirstName       String?
  memberLastName        String?
  memberEmail           String?
  memberDirectPhone     String?
  memberMobilePhone     String?
  memberStateLicense    String?
  memberDesignation     String?
  officeName            String?
  officeKey             String?
  officeMlsId           String?
  media                 String?
  modificationTimestamp DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([memberFullName])
  @@index([officeKey])
  @@index([modificationTimestamp])
}

model Office {
  id                    String    @id @default(uuid())
  officeKey             String    @unique
  officeMlsId           String?
  officeName            String?
  officePhone           String?
  officeEmail           String?
  officeAddress1        String?
  officeCity            String?
  officeStateOrProvince String?
  officePostalCode      String?
  officeType            String?
  officeStatus          String?
  modificationTimestamp DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([officeName])
  @@index([modificationTimestamp])
}

model JobRecord {
  id         String    @id
  type       String
  status     String    @default("pending")
  payload    String
  attempts   Int       @default(0)
  error      String?
  enqueuedAt DateTime
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([type, status])
  @@index([enqueuedAt])
}

model SourcingLead {
  id                 String   @id @default(uuid())
  organizationId     String
  sourceVendor       String
  sourceReferenceId  String?
  address            String
  city               String?
  state              String?
  zipCode            String?
  propertyType       String?
  estimatedValue     BigInt?
  ownerName          String?
  ownerContact       String?
  criteriaVersion    String   @default("v1")
  costPerLead        BigInt?
  estimatedMargin    BigInt?
  ownershipShares    Json?
  status             String   @default("New")
  convertedProjectId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([sourceVendor])
}

model RehabProject {
  id              String           @id @default(uuid())
  linkedProjectId String           @unique
  organizationId  String
  status          String           @default("Planning")
  estimatedBudget BigInt           @default(0)
  actualCost      BigInt           @default(0)
  startDate       DateTime?
  endDate         DateTime?
  ownershipShares Json?
  criteriaVersion String           @default("v1")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  changeOrders    ChangeOrder[]
  documents       RehabDocument[]
  milestones      RehabMilestone[]

  @@index([organizationId])
  @@index([status])
}

model RehabMilestone {
  id             String         @id @default(uuid())
  rehabProjectId String
  title          String
  description    String?
  status         String         @default("Pending")
  estimatedCost  BigInt         @default(0)
  actualCost     BigInt         @default(0)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  invoices       RehabInvoice[]
  rehabProject   RehabProject   @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)
  bids           VendorBid[]

  @@index([rehabProjectId])
}

model Vendor {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  type           String
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  invoices       RehabInvoice[]
  bids           VendorBid[]

  @@index([organizationId])
}

model VendorBid {
  id          String         @id @default(uuid())
  vendorId    String
  milestoneId String
  bidAmount   BigInt
  status      String         @default("Pending")
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  milestone   RehabMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([milestoneId])
}

model RehabInvoice {
  id          String         @id @default(uuid())
  vendorId    String
  milestoneId String
  amount      BigInt
  status      String         @default("Pending")
  documentUrl String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  milestone   RehabMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([milestoneId])
}

model ChangeOrder {
  id             String       @id @default(uuid())
  rehabProjectId String
  description    String
  requestedCost  BigInt
  approvedCost   BigInt?
  status         String       @default("Pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  rehabProject   RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)

  @@index([rehabProjectId])
}

model RehabDocument {
  id             String       @id @default(uuid())
  rehabProjectId String
  title          String
  type           String
  fileUrl        String
  createdAt      DateTime     @default(now())
  rehabProject   RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)

  @@index([rehabProjectId])
}

model AppUser {
  id              String                @id
  email           String                @unique
  name            String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  fieldAssignedBy FieldAssignment[]     @relation("FieldAssignedBy")
  fieldAssignedTo FieldAssignment[]     @relation("FieldAssignedTo")
  collaborations  ProjectCollaborator[]
  projects        ReilProject[]
  statusEvents    StatusEvent[]
}

model ReilProject {
  id                 String                  @id @default(uuid())
  addressLine        String                  @default("")
  city               String                  @default("")
  state              String                  @default("")
  zip                String                  @default("")
  lat                Float?
  lng                Float?
  placeId            String?
  displayName        String?
  acquisitionStatus  AcquisitionStatus       @default(PROSPECT)
  ownershipStructure OwnershipStructure?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  createdById        String
  coOwners           String[]
  entityName         String?
  entityType         String?
  lastSyncedAt       DateTime?
  marketSyncedAt     DateTime?
  rentSyncedAt       DateTime?
  valueSyncedAt      DateTime?
  status             String                  @default("acquisition")
  dispositionType    String?
  subStrategy        String?
  holdHorizon        Int?
  exitAssumption     String?
  entryStage         String?
  lastActiveStage    String?
  overrideReason     String?
  propertyType       String?
  units              Int?
  condition          String?
  retrospective      Boolean                 @default(false)
  // AQ-5 Source Card
  leadSource          String?
  listingUrl          String?
  askingPriceCents    BigInt?
  subjectDom          Int?
  leadAgent           String?
  dateIdentified      DateTime?

  // AQ-5 Seller Card
  sellerName          String?
  sellerType          String?
  sellerMotivation    String?
  sellerContact       String?

  // AQ-5 Market Card
  submarket           String?
  medianSalesPriceCents BigInt?
  medianRentCents     BigInt?
  marketVacancyRate   Float?
  hazardFlag          Boolean                 @default(false)
  hazardNote          String?

  // AQ-6 First-Pass Screen
  firstPassRentCents  BigInt?
  firstPassVerdict    String?

  // AQ-7 Comps & ARV
  arvCents            BigInt?
  fieldAssignments   FieldAssignment[]
  collaborators      ProjectCollaborator[]
  comps              ReilComp[]
  createdBy          AppUser                 @relation(fields: [createdById], references: [id])
  propertyFacts      ReilPropertyFacts?
  purchaseTerms      ReilPurchaseTerms?
  valuationSnapshots ReilValuationSnapshot[]
  statusEvents       StatusEvent[]
  capitalSources     CapitalSource[]
  equityParties      EquityParty[]
  loans              LoanRecord[]
  contributions      ContributionEntry[]

  @@index([createdById])
  @@index([acquisitionStatus])
}

model ReilPropertyFacts {
  id                              String      @id @default(uuid())
  projectId                       String      @unique
  apn                             String?
  photoUrl                        String?
  beds                            Int?
  baths                           Float?
  sqft                            Int?
  yearBuilt                       Int?
  lotSqft                         Int?
  propertyType                    String?
  listPriceCents                  BigInt?
  estRentCents                    BigInt?
  lastSoldPriceCents              BigInt?
  lastSoldDate                    DateTime?
  sourceProvider                  String?
  fetchedAt                       DateTime?
  annualPropertyTaxCents          BigInt?
  hoaMonthlyCents                 BigInt?
  taxAssessedValueCents           BigInt?
  taxSource                       String?
  taxYear                         Int?
  avmPriceCents                   BigInt?
  avmPriceHighCents               BigInt?
  avmPriceLowCents                BigInt?
  estRentHighCents                BigInt?
  estRentLowCents                 BigInt?
  taxAssessedImprovementsValCents BigInt?
  taxAssessedLandValCents         BigInt?
  project                         ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ReilComp {
  id             String      @id @default(uuid())
  projectId      String
  addressLine    String
  soldPriceCents BigInt?
  soldDate       DateTime?
  beds           Int?
  baths          Float?
  sqft           Int?
  distanceMiles  Float?
  compType       String      @default("SALE")
  correlation    Float?
  daysOnMarket   Int?
  listedDate     DateTime?
  priceCents     BigInt?
  status         String?
  condition      String?
  project        ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ReilValuationSnapshot {
  id             String      @id @default(uuid())
  projectId      String
  valueCents     BigInt
  valueLowCents  BigInt
  valueHighCents BigInt
  source         String
  fetchedAt      DateTime
  createdAt      DateTime    @default(now())
  project        ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, fetchedAt])
}

model ReilPurchaseTerms {
  id                   String         @id @default(uuid())
  projectId            String         @unique
  offerMadeCents       BigInt?
  offerDate            DateTime?
  sellerResponse       SellerResponse @default(PENDING)
  counterPriceCents    BigInt?
  acceptedPriceCents   BigInt?
  earnestMoneyCents    BigInt?
  estClosingCostsCents BigInt?
  amountPaidCents      BigInt?
  project              ReilProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StatusEvent {
  id           String            @id @default(uuid())
  projectId    String
  status       AcquisitionStatus
  note         String?
  occurredAt   DateTime          @default(now())
  recordedById String
  project      ReilProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy   AppUser           @relation(fields: [recordedById], references: [id])

  @@index([projectId])
}

model ProjectCollaborator {
  id         String      @id @default(uuid())
  projectId  String
  userId     String
  role       MemberRole  @default(VIEWER)
  invitedAt  DateTime    @default(now())
  acceptedAt DateTime?
  project    ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       AppUser     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model FieldAssignment {
  id           String      @id @default(uuid())
  projectId    String
  fieldKey     String
  assignedToId String
  assignedById String
  status       FieldStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  assignedBy   AppUser     @relation("FieldAssignedBy", fields: [assignedById], references: [id])
  assignedTo   AppUser     @relation("FieldAssignedTo", fields: [assignedToId], references: [id])
  project      ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assignedToId])
}

enum AcquisitionStatus {
  PROSPECT
  UNDERWRITING
  OFFER_MADE
  UNDER_CONTRACT
  DUE_DILIGENCE
  CLEAR_TO_CLOSE
  CLOSED
  DEAD
  PRE_POSSESSION
  OWNED
}

enum OwnershipStructure {
  SOLE_OWNER
  JOINT_VENTURE
  LLC
  LP
  TRUST
  SYNDICATION
  SOLE_SEVERALTY
  JOINT_TENANCY
  TENANCY_IN_COMMON
  TENANCY_BY_ENTIRETY
  COMMUNITY_PROPERTY
  ENTITY
}

enum MemberRole {
  OWNER
  PARTNER
  ANALYST
  VIEWER
}

enum SellerResponse {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
}

enum FieldStatus {
  OPEN
  FILLED
}

model CapitalSource {
  id          String      @id @default(uuid())
  projectId   String
  type        String      // solo_cash | co_buyer_equity | syndication_equity | conventional_loan | hard_money | bridge | sba_504_bank | sba_504_cdc | sba_504_injection
  amount      BigInt      @default(0)
  seniority   Int         @default(0)
  status      String      // committed | pending | confirmed
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model EquityParty {
  id             String              @id @default(uuid())
  projectId      String
  name           String
  role           String              // co_buyer | GP | LP
  entityType     String              // Individual | LLC | etc.
  linkageUserId  String?             // Optional link to AppUser.id
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  project        ReilProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contributions  ContributionEntry[]

  @@index([projectId])
}

model LoanRecord {
  id          String      @id @default(uuid())
  projectId   String
  lender      String
  amount      BigInt      @default(0)
  rate        Float       @default(0)
  termYears   Int         @default(0)
  points      Float       @default(0)
  status      String      // application | processing | appraisal_ordered | appraisal_received | conditions_issued | clear_to_close
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ContributionEntry {
  id             String      @id @default(uuid())
  projectId      String
  partyId        String
  amount         BigInt      @default(0)
  status         String      // soft-committed | docs_out | signed | funds_confirmed
  evidenceRef    String?
  date           DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  project        ReilProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  party          EquityParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([partyId])
}

