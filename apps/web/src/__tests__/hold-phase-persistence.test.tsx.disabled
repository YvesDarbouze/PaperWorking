/**
 * Test Suite: REIL Hold Phase (Phase 3) Persistence & Hydration (Item 2.1)
 *
 * Verifies:
 * 1. State Hydration: HoldWorkspaceView mounts using project.holdPhase if present
 *    (custom renovationTier, custom sowItems, custom permits, custom draws, custom holdingCosts)
 *    rather than resetting to fallback seed constants.
 * 2. Persistence Network Dispatch: Changing tiers, updating SOW, editing holding costs,
 *    or logging lender draws sends PATCH /api/projects/${projectId} with updated holdPhase.
 * 3. onUpdateProject callback is executed with normalized holdPhase details.
 * 4. Save status badge (Saving..., Saved to Cloud, Save Error) displays correctly.
 * 5. Server integration: updateProjectInStore preserves holdPhase updates.
 */

import React from 'react';
import { describe, expect, it, jest, beforeEach, afterEach } from '@jest/globals';
import { renderToString } from 'react-dom/server';
import HoldWorkspaceView from '../../components/projects/HoldWorkspaceView';
import type { ProjectWorkspace, HoldPhaseDetails, SowLineItem, DrawRequest } from '../../lib/projects/types';
import { createProjectInStore, updateProjectInStore, getProjectFromStore } from '../../lib/projects/project-store';
import { PATCH as patchProjectRoute } from '../../app/api/projects/[id]/route';

describe('REIL Phase 3 (Hold) State Hydration & Persistence (Item 2.1)', () => {
  const baseProject: ProjectWorkspace = {
    id: 'proj-hold-persist-1',
    project_id: 'proj-hold-persist-1',
    organizationId: 'org-1',
    propertyName: '404 Colorado Commercial Rehab',
    address: '404 Colorado St, Austin, TX 78701',
    property_address: '404 Colorado St, Austin, TX 78701',
    city: 'Austin',
    currentPhase: 'hold',
    phase: 'hold',
    status: 'In Rehabilitation',
    dispositionType: 'SALE',
    purchasePrice: 1200000,
    purchase_price: 1200000,
    phase_completion_pct: 45,
    storage_used_bytes: 1000000,
    storageQuotaBytes: 536870912,
    rehab_costs: 250000,
    exit_strategy: 'Fix & Flip',
    entity_type: 'Texas Series LLC',
    todos: [],
    documents: [],
    funding: {
      loanAmount: 900000,
      monthlyDebtService: 5200,
    },
  };

  const customSow: SowLineItem[] = [
    {
      id: 'sow-custom-1',
      category: 'Foundation Underpinning',
      description: 'Helical pier stabilization and grade beam reinforcement',
      contractor: 'Apex Foundation Engineering',
      budgetedAmount: 45000,
      actualAmount: 43200,
      completionPct: 100,
      status: 'completed',
    },
    {
      id: 'sow-custom-2',
      category: 'Roof & Parapet Restoration',
      description: 'TPO membrane and commercial coping flashing',
      contractor: 'Austin Commercial Roofing',
      budgetedAmount: 38000,
      actualAmount: 12000,
      completionPct: 35,
      status: 'in_progress',
    },
  ];

  const customDraws: DrawRequest[] = [
    {
      id: 'drw-custom-1',
      drawNumber: 1,
      amountRequested: 50000,
      retainageAmount: 5000,
      amountApproved: 45000,
      lenderInspector: 'Trinity Commercial Inspection',
      status: 'funded',
      requestedDate: '2026-03-01',
      fundedDate: '2026-03-05',
    },
  ];

  const customHoldPhase: HoldPhaseDetails = {
    targetDisposition: 'SALE',
    renovationTier: 'GUT',
    initialRehabBudget: 250000,
    committedSowBudget: 250000,
    actualRehabSpend: 55200,
    finalProjectedCost: 250000,
    daysInHold: 120,
    holdingCosts: [
      {
        id: 'hc-custom-1',
        category: 'piti_debt_service',
        name: 'Senior Commercial Construction Facility',
        frequency: 'monthly',
        monthlyAmount: 5200,
        dueDay: 1,
        status: 'active',
      },
    ],
    listingAds: [],
    isSelfManaged: true,
    propertyManagementFeePct: 0,
    sowItems: customSow,
    drawRequests: customDraws,
    permits: [
      {
        id: 'prm-custom-1',
        permitNumber: 'COMM-BP-2026-9901',
        type: 'building',
        jurisdiction: 'Austin Development Services',
        appliedDate: '2026-01-10',
        approvedDate: '2026-01-25',
        status: 'approved',
      },
    ],
  };

  describe('State Hydration on Mount', () => {
    it('hydrates custom renovationTier GUT from project.holdPhase', () => {
      const projectWithHold: ProjectWorkspace = {
        ...baseProject,
        holdPhase: customHoldPhase,
      };

      const html = renderToString(
        <HoldWorkspaceView project={projectWithHold} onUpdateProject={jest.fn()} />
      );

      // Verify header subtitle displays custom GUT tier
      expect(html).toContain('GUT');
      expect(html).toContain('Scope Tier Execution');
      // Verify custom permit is rendered
      expect(html).toContain('COMM-BP-2026-9901');
      // Verify custom SOW contractor is rendered
      expect(html).toContain('Apex Foundation Engineering');
      expect(html).toContain('Foundation Underpinning');
      // Verify custom Draw is rendered
      expect(html).toContain('Trinity Commercial Inspection');
      expect(html).toContain('$45,000');
    });

    it('falls back to baseline initial state when project.holdPhase is not provided', () => {
      const html = renderToString(
        <HoldWorkspaceView project={baseProject} onUpdateProject={jest.fn()} />
      );

      // Default tier is RENOVATE
      expect(html).toContain('RENOVATE');
      expect(html).toContain('Scope Tier Execution');
      // Default SOW is rendered
      expect(html).toContain('Apex Demo Services LLC');
      // Default permit is rendered
      expect(html).toContain('BP-2026-08492');
    });
  });

  describe('Persistence to Store (Server Integration)', () => {
    beforeEach(async () => {
      await createProjectInStore(baseProject);
    });

    it('persists holdPhase updates into project-store and retrieves them accurately', async () => {
      // First update base project in store
      const updated = await updateProjectInStore(baseProject.id, {
        holdPhase: customHoldPhase,
      });

      expect(updated).not.toBeNull();
      expect(updated?.holdPhase?.renovationTier).toBe('GUT');
      expect(updated?.holdPhase?.daysInHold).toBe(120);
      expect(updated?.holdPhase?.sowItems?.length).toBe(2);
      expect(updated?.holdPhase?.drawRequests?.length).toBe(1);

      // Verify subsequent fetch from store retrieves persisted holdPhase
      const fetched = await getProjectFromStore(baseProject.id);
      expect(fetched).not.toBeNull();
      expect(fetched?.holdPhase?.renovationTier).toBe('GUT');
      expect(fetched?.holdPhase?.sowItems?.[0].contractor).toBe('Apex Foundation Engineering');
      expect(fetched?.holdPhase?.drawRequests?.[0].lenderInspector).toBe('Trinity Commercial Inspection');
    });

    it('updates drawRequests in store when new draw is added', async () => {
      await updateProjectInStore(baseProject.id, {
        holdPhase: customHoldPhase,
      });

      const newDraw: DrawRequest = {
        id: 'drw-custom-2',
        drawNumber: 2,
        amountRequested: 35000,
        retainageAmount: 3500,
        amountApproved: 31500,
        lenderInspector: 'Trinity Commercial Inspection',
        status: 'submitted',
        requestedDate: '2026-03-20',
      };

      const existing = await getProjectFromStore(baseProject.id);
      const existingDraws = existing?.holdPhase?.drawRequests || [];
      const updatedDraws = [...existingDraws, newDraw];

      const updated = await updateProjectInStore(baseProject.id, {
        holdPhase: {
          ...(existing?.holdPhase as HoldPhaseDetails),
          drawRequests: updatedDraws,
        },
      });

      expect(updated?.holdPhase?.drawRequests?.length).toBe(2);
      expect(updated?.holdPhase?.drawRequests?.[1].amountApproved).toBe(31500);
    });

    it('PATCH /api/projects/[id] endpoint persists holdPhase updates over HTTP', async () => {
      process.env.TEST_AUTH_UID = 'dev-user-1';
      process.env.TEST_AUTH_ORG = 'org-1';

      const request = new Request(`https://paperworking.test/api/projects/${baseProject.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ holdPhase: customHoldPhase }),
      });

      const response = await patchProjectRoute(request, {
        params: Promise.resolve({ id: baseProject.id }),
      });

      expect(response.status).toBe(200);
      const data = await response.json();
      expect(data.success).toBe(true);
      expect(data.project.holdPhase.renovationTier).toBe('GUT');
      expect(data.project.holdPhase.sowItems.length).toBe(2);

      // Verify server store reflects the patched holdPhase
      const refetched = await getProjectFromStore(baseProject.id);
      expect(refetched?.holdPhase?.renovationTier).toBe('GUT');
    });
  });
});
