rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────
    // Get the authenticated user's profile document
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if the caller is a member of the project and return their role
    function getProjectRole(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return project.members[request.auth.uid].role;
    }

    // Check if user is a member of the project at all
    function isProjectMember(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return request.auth.uid in project.members;
    }

    // Check if user has access to a specific tenant/organization
    function hasTenantAccess(orgId) {
      let userDoc = getUserDoc();
      return request.auth != null && (
        (userDoc.memberships != null && orgId in userDoc.memberships) ||
        orgId == userDoc.personalOrganizationId ||
        orgId == userDoc.organizationId
      );
    }

    // Check if user belongs to the same organization as the project
    function isInProjectOrg(data) {
      return hasTenantAccess(data.organizationId);
    }

    // Check if the user has scoped project access (if scoped)
    function hasProjectScopeAccess(projectId, projectData) {
      let userDoc = getUserDoc();
      let orgId = projectData.organizationId;
      return userDoc == null
        || !('membershipScopes' in userDoc)
        || !(orgId in userDoc.membershipScopes)
        || !userDoc.membershipScopes[orgId].isScoped
        || (projectId in userDoc.membershipScopes[orgId].scopedProjectIds);
    }

    // Check if user belongs to the same organization as the project and has scope access
    function canAccessProject(projectId, projectData) {
      return hasTenantAccess(projectData.organizationId) && hasProjectScopeAccess(projectId, projectData);
    }

    // Role hierarchy checks — returns true if user's project role is in the allowed set
    function hasRole(projectId, allowedRoles) {
      return isProjectMember(projectId) && (getProjectRole(projectId) in allowedRoles);
    }

    // Check if the project is closed
    function isProjectClosed(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.status in ['closed_won', 'closed_lost'];
    }

    // ─── NEW: Vendor type helper ────────────────────────────────────────
    // Returns the vendor type from the project's members map for the current user.
    // Vendor type is stored in members[uid].role (e.g. 'Vendor', 'Lender')
    // or more granularly in members[uid].vendorType for scoped writes.
    function getProjectMemberData(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return project.members[request.auth.uid];
    }

    // Check if the current user is the project owner
    function isProjectOwner(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid;
    }

    // Check if user is a linked equity party (LP or co-buyer) on the project
    function isLinkedEquityParty(projectData) {
      return request.auth != null &&
             'equityParties' in projectData &&
             projectData.equityParties != null &&
             projectData.equityParties.any(party,
               ('memberId' in party && party.memberId == request.auth.uid) ||
               ('email' in party && party.email != null && request.auth.token.email != null && party.email.lower() == request.auth.token.email.lower())
             );
    }

    // Check if user is a project member or a linked equity party
    function isProjectMemberOrLinked(projectId) {
      let projectData = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return (projectData.members != null && request.auth.uid in projectData.members) ||
             isLinkedEquityParty(projectData);
    }

    // Returns the slotKey in project.financials matching the authenticated user
    function getVendorSlotKey(projectData) {
      return ('financials' in projectData && projectData.financials != null) ? (
        (('f4TitleEscrowVendor' in projectData.financials && projectData.financials.f4TitleEscrowVendor != null) && 
         (projectData.financials.f4TitleEscrowVendor.marketplaceVendorId == request.auth.uid || 
          (projectData.financials.f4TitleEscrowVendor.email != null && request.auth.token.email != null && projectData.financials.f4TitleEscrowVendor.email.lower() == request.auth.token.email.lower()))) ? 'f4TitleEscrowVendor' :
        (('f4ClosingAttorneyVendor' in projectData.financials && projectData.financials.f4ClosingAttorneyVendor != null) && 
         (projectData.financials.f4ClosingAttorneyVendor.marketplaceVendorId == request.auth.uid || 
          (projectData.financials.f4ClosingAttorneyVendor.email != null && request.auth.token.email != null && projectData.financials.f4ClosingAttorneyVendor.email.lower() == request.auth.token.email.lower()))) ? 'f4ClosingAttorneyVendor' :
        (('f4AppraiserVendor' in projectData.financials && projectData.financials.f4AppraiserVendor != null) && 
         (projectData.financials.f4AppraiserVendor.marketplaceVendorId == request.auth.uid || 
          (projectData.financials.f4AppraiserVendor.email != null && request.auth.token.email != null && projectData.financials.f4AppraiserVendor.email.lower() == request.auth.token.email.lower()))) ? 'f4AppraiserVendor' :
        (('f4EnvironmentalVendor' in projectData.financials && projectData.financials.f4EnvironmentalVendor != null) && 
         (projectData.financials.f4EnvironmentalVendor.marketplaceVendorId == request.auth.uid || 
          (projectData.financials.f4EnvironmentalVendor.email != null && request.auth.token.email != null && projectData.financials.f4EnvironmentalVendor.email.lower() == request.auth.token.email.lower()))) ? 'f4EnvironmentalVendor' :
        (('f4SurveyorVendor' in projectData.financials && projectData.financials.f4SurveyorVendor != null) && 
         (projectData.financials.f4SurveyorVendor.marketplaceVendorId == request.auth.uid || 
          (projectData.financials.f4SurveyorVendor.email != null && request.auth.token.email != null && projectData.financials.f4SurveyorVendor.email.lower() == request.auth.token.email.lower()))) ? 'f4SurveyorVendor' :
        (('f4InsuranceBrokerVendor' in projectData.financials && projectData.financials.f4InsuranceBrokerVendor != null) && 
         (projectData.financials.f4InsuranceBrokerVendor.marketplaceVendorId == request.auth.uid || 
          (projectData.financials.f4InsuranceBrokerVendor.email != null && request.auth.token.email != null && projectData.financials.f4InsuranceBrokerVendor.email.lower() == request.auth.token.email.lower()))) ? 'f4InsuranceBrokerVendor' :
        (('f4CdcVendor' in projectData.financials && projectData.financials.f4CdcVendor != null) && 
         (projectData.financials.f4CdcVendor.marketplaceVendorId == request.auth.uid || 
          (projectData.financials.f4CdcVendor.email != null && request.auth.token.email != null && projectData.financials.f4CdcVendor.email.lower() == request.auth.token.email.lower()))) ? 'f4CdcVendor' :
        (('f4HardMoneyLenderVendor' in projectData.financials && projectData.financials.f4HardMoneyLenderVendor != null) && 
         (projectData.financials.f4HardMoneyLenderVendor.marketplaceVendorId == request.auth.uid || 
          (projectData.financials.f4HardMoneyLenderVendor.email != null && request.auth.token.email != null && projectData.financials.f4HardMoneyLenderVendor.email.lower() == request.auth.token.email.lower()))) ? 'f4HardMoneyLenderVendor' : ''
      ) : '';
    }

    // Maps slotKey to one of the five canonical Data Room folders
    function getFolderForSlotKey(slotKey) {
      return slotKey == 'f4HardMoneyLenderVendor' ? 'Debt' :
             slotKey == 'f4CdcVendor' ? 'Debt' :
             slotKey == 'f4AppraiserVendor' ? 'Debt' :
             slotKey == 'f4TitleEscrowVendor' ? 'Title & Insurance' :
             slotKey == 'f4EnvironmentalVendor' ? 'Title & Insurance' :
             slotKey == 'f4SurveyorVendor' ? 'Title & Insurance' :
             slotKey == 'f4InsuranceBrokerVendor' ? 'Title & Insurance' :
             slotKey == 'f4ClosingAttorneyVendor' ? 'Closing' : '';
    }

    // Resolves/guesses the folder for a documents subcollection file
    function getFolderForSubDoc(docData) {
      return ('folderName' in docData && docData.folderName != null) ? docData.folderName :
             ('folderId' in docData && docData.folderId != null) ? docData.folderId :
             (('ocrDocumentType' in docData && docData.ocrDocumentType == 'appraisal') || ('category' in docData && docData.category == 'Debt')) ? 'Debt' :
             (('ocrDocumentType' in docData && docData.ocrDocumentType == 'closing_disclosure') || ('category' in docData && docData.category == 'Closing')) ? 'Closing' :
             (('ocrDocumentType' in docData && docData.ocrDocumentType == 'title_report') || ('category' in docData && docData.category == 'Title & Insurance')) ? 'Title & Insurance' :
             ('category' in docData && (docData.category == 'Equity' || docData.category == 'Subscription')) ? 'Equity' :
             ('category' in docData && (docData.category == 'Capital Plan' || docData.category == 'Proof of Funds')) ? 'Capital Plan' : 'Closing';
    }


    // ─── Organizations ─────────────────────────────────────────────────
    // Only the organization owner can write; members can read their own org.
    match /organizations/{orgId} {
      allow read: if request.auth != null
                  && hasTenantAccess(orgId);
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
      allow delete: if false; // Orgs are never client-deleted

      // ─── Metric Snapshots (Org Sub-Collection) ─────────────────────
      // Read-only for org members. Writes are server-side (Admin SDK).
      match /metricSnapshots/{snapshotId} {
        allow read: if request.auth != null
                    && hasTenantAccess(orgId);
        allow write: if false; // Admin SDK only
      }
    }

    // ─── Users ─────────────────────────────────────────────────────────
    // Users can read/write their own profile. No cross-user reads.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // User docs are never client-deleted

      // ─── Sessions (Sub-Collection) ───────────────────────────────────
      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.isValid == false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // ─── Vendor Inbox (Sub-Collection) ──────────────────────────────
      // Vendors can read their own inbox items and update status only.
      // Creates are server-side via Admin SDK (batch writes).
      match /vendorInbox/{inboxItemId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        // Vendor can update status field only (accept/decline)
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status']);

        allow create, delete: if false; // Server-side only
      }
    }

    // ─── Projects ──────────────────────────────────────────────────────
    // Only project members within the same org can read.
    // Only Lead Investor and General Contractor can write.
    // Only Lead Investor can delete.
    match /projects/{projectId} {
      allow read: if request.auth != null
                  && (
                    canAccessProject(projectId, resource.data) ||
                    (resource.data.members != null && request.auth.uid in resource.data.members) ||
                    isLinkedEquityParty(resource.data)
                  );

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
                    && hasRole(projectId, ['Lead Investor', 'General Contractor'])
                    && canAccessProject(projectId, resource.data)
                    && !isProjectClosed(projectId);

      allow delete: if request.auth != null
                    && hasRole(projectId, ['Lead Investor'])
                    && canAccessProject(projectId, resource.data)
                    && !isProjectClosed(projectId);

      // ─── Ledger Items (Sub-Collection) ─────────────────────────────
      // All project members can read. Only finance-authorized roles can write.
      match /ledgerItems/{itemId} {
        allow read: if request.auth != null
                    && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data);

        // Lead Investor, General Contractor, and Accountant can create items
        allow create: if request.auth != null
                      && hasRole(projectId, ['Lead Investor', 'General Contractor', 'Accountant'])
                      && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data)
                      && !isProjectClosed(projectId);

        // Only Lead Investor and Accountant can approve/reject (update)
        allow update: if request.auth != null
                      && hasRole(projectId, ['Lead Investor', 'Accountant'])
                      && !isProjectClosed(projectId);

        // Only Lead Investor can delete ledger items
        allow delete: if request.auth != null
                      && hasRole(projectId, ['Lead Investor'])
                      && !isProjectClosed(projectId);
      }

      // ─── Phase Snapshots (Sub-Collection) ──────────────────────────
      // Snapshots are immutable once captured to preserve historical accuracy.
      match /phaseSnapshots/{phaseKey} {
        allow read: if request.auth != null
                    && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data);

        // Allow Lead Investor to create a snapshot, but not update or delete it
        allow create: if request.auth != null
                      && hasRole(projectId, ['Lead Investor'])
                      && !isProjectClosed(projectId);

        allow update, delete: if false;
      }

      // ─── Vendor Requests (Sub-Collection) ──────────────────────────
      // ENHANCED: Tighter read/write with vendor-scoped access.
      // Read: project org members OR the referenced vendor
      // Create: authenticated project org members (subscription enforced in API)
      // Update: project org members (for status changes) OR the referenced vendor (for submitting quotes)
      match /vendorRequests/{requestId} {
        allow read: if request.auth != null
                    && (canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data)
                        || request.auth.uid == resource.data.vendorUid);

        allow create: if request.auth != null
                      && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data);

        // Vendors can update quote-related fields only; org members can update status
        allow update: if request.auth != null
                      && (
                        // Org members (Lead Investor etc.) can update any field
                        canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data)
                        // The vendor can only update quote-related fields
                        || (request.auth.uid == resource.data.vendorUid
                            && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['status', 'quotedFee', 'message', 'quotedAt']))
                      );

        allow delete: if false; // Vendor requests are never client-deleted
      }

      // ─── Vendor Assignments (Sub-Collection) ──────────────────────
      // Project-scoped vendor assignment lifecycle.
      match /vendorAssignments/{assignmentId} {
        allow read: if request.auth != null
                    && (canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data)
                        || request.auth.uid == resource.data.vendorId);

        // Only project org members can create assignments
        allow create: if request.auth != null
                      && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data)
                      && !isProjectClosed(projectId);

        // Vendors can accept/decline (status only); project members can update more
        allow update: if request.auth != null
                      && !isProjectClosed(projectId)
                      && (
                        canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data)
                        || (request.auth.uid == resource.data.vendorId
                            && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['status', 'respondedAt', 'quotedFee', 'updatedAt']))
                      );

        allow delete: if false;
      }

      // ─── Private Financials (Sub-Collection) ───────────────────────
      // This is the True Field-Level Security workaround.
      // Only Lead Investor, Accountant, and Lender can read.
      // Only server-side (Admin SDK) should write — but we allow Lead Investor
      // as a fallback for the Engine Room recalculation.
      match /privateFinancials/{docId} {
        allow read: if request.auth != null
                    && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data);

        allow write: if request.auth != null
                     && hasRole(projectId, ['Lead Investor'])
                     && !isProjectClosed(projectId);
      }

      // ─── Investors (Sub-Collection) ───────────────────────────────
      // ENHANCED: Investor commitment tracking.
      // Read: all project org members.
      // Create: Lead Investor (invites) or the investor themselves (self-commitment).
      // Update: investors can only update their own commitment entry.
      match /investors/{investorId} {
        allow read: if request.auth != null
                    && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data);

        // Lead Investor can create commitment entries (invitations)
        allow create: if request.auth != null
                      && (hasRole(projectId, ['Lead Investor'])
                          || request.auth.uid == investorId);

        // Investors can only update their own commitment
        // (confirming pledge, updating amount)
        allow update: if request.auth != null
                      && request.auth.uid == investorId
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'confirmedAt', 'contributionAmount', 'equityPercentage']);

        allow delete: if request.auth != null
                      && hasRole(projectId, ['Lead Investor']);
      }

      // ─── Messages (Sub-Collection) ────────────────────────────────
      // Project-level message board.
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data);

        allow create: if request.auth != null
                      && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data);

        allow update, delete: if false; // Messages are immutable
      }

      // ─── Field History (Sub-Collection) ────────────────────────────
      // Audit trail for field-level changes.
      match /fieldHistory/{historyId} {
        allow read: if request.auth != null
                    && canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data);

        allow write: if false; // Server-side only
      }

      // ─── Documents (Sub-Collection) ──────────────────────────────
      match /documents/{docId} {
        allow read: if request.auth != null
                    && (
                      canAccessProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data)
                      || (
                        isProjectMemberOrLinked(projectId) && (
                          resource.data.uploadedByUid == request.auth.uid
                          || ('recipientUid' in resource.data && resource.data.recipientUid == request.auth.uid)
                          || ('recipientEmail' in resource.data && resource.data.recipientEmail != null && request.auth.token.email != null && resource.data.recipientEmail.lower() == request.auth.token.email.lower())
                          || resource.data.category == 'Deal identity'
                          || ('isPublic' in resource.data && resource.data.isPublic == true)
                        )
                      )
                      || (
                        getFolderForSlotKey(getVendorSlotKey(get(/databases/$(database)/documents/projects/$(projectId)).data)) == getFolderForSubDoc(resource.data)
                      )
                    );

        allow write: if request.auth != null
                     && (
                       hasRole(projectId, ['Lead Investor'])
                       || (
                         isProjectMemberOrLinked(projectId) &&
                         request.resource.data.uploadedByUid == request.auth.uid
                       )
                     );
      }
    }

    // ─── Property Metric Snapshots ─────────────────────────────────────
    // ENHANCED: Top-level collection. Client reads require project access.
    // Client writes are DENIED — only Cloud Functions / Admin SDK can write.
    match /propertyMetricSnapshots/{snapshotId} {
      allow read: if request.auth != null
                  && hasTenantAccess(resource.data.organizationId);

      // Deny all client writes — only Admin SDK / Cloud Functions
      allow create, update, delete: if false;
    }

    // ─── Stripe Events ────────────────────────────────────────────────
    // ENHANCED: Fully locked. Only accessible via Admin SDK (webhook handler).
    // No client should ever read or write billing/payment event data.
    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    // ─── Waitlist (Landing Page Lead Capture) ──────────────────────────
    // Anyone can add their email; nobody can read/update/delete.
    match /waitlist/{entryId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ─── Inbox Items ───────────────────────────────────────────────────
    // Top-level collection. Server (Admin SDK) creates and deletes items.
    // Recipients can read their own items and update state fields only.
    match /inboxItems/{itemId} {
      allow read: if request.auth != null
                  && resource.data.recipientUid == request.auth.uid;

      // Recipients can update read/archived/actionTaken/readAt only
      allow update: if request.auth != null
                    && resource.data.recipientUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read', 'archived', 'actionTaken', 'readAt']);

      // Creates and deletes are server-side only (Admin SDK bypasses rules)
      allow create, delete: if false;
    }

    // ─── Notifications ─────────────────────────────────────────────────
    // ENHANCED: Top-level collection. Server (Admin SDK) creates and deletes items.
    // Recipients can read their own notifications and update state fields only.
    // Uses recipientId field (not userId) per NotificationService.
    match /notifications/{notificationId} {
      allow read: if request.auth != null
                  && resource.data.recipientId == request.auth.uid;

      // Recipients can update read/archived/readAt only
      allow update: if request.auth != null
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read', 'archived', 'readAt']);

      // Creates and deletes are server-side only (Admin SDK bypasses rules)
      allow create, delete: if false;
    }

    // ─── Invitations ──────────────────────────────────────────────────
    // Server-managed. No client reads/writes (Admin SDK bypasses rules).
    match /invitations/{invitationId} {
      allow read, write: if false;
    }

    // ─── Team Invitations ─────────────────────────────────────────────
    // ENHANCED: Server-managed lifecycle. No client reads/writes.
    match /teamInvitations/{invitationId} {
      allow read, write: if false;
    }

    // ─── Audit Log ─────────────────────────────────────────────────────
    // Immutable append-only log. Only server should write, but we allow
    // authenticated creates. No reads, updates, or deletes from client.
    match /auditLog/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ─── Audit Logs (alternate collection names) ──────────────────────
    // Some code paths may reference these; lock them down identically.
    match /auditLogs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ─── Queued Emails ────────────────────────────────────────────────
    // Server-side only. Processed by cron jobs and Cloud Functions.
    match /queued_emails/{emailId} {
      allow read, write: if false;
    }

    // ─── Pending Subscriptions ────────────────────────────────────────
    // Server-side only. Created during Stripe checkout flow.
    match /pending_subscriptions/{subId} {
      allow read, write: if false;
    }

    // ─── Support Tickets ──────────────────────────────────────────────
    // Users can create support tickets. Only read own tickets.
    match /support_tickets/{ticketId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false; // Admin SDK only
    }

    // ─── Support Messages ─────────────────────────────────────────────
    // Users can read messages on their own tickets. Creates are server-side.
    match /support_messages/{messageId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    // ─── Investment Tokens ────────────────────────────────────────────
    // Guest portal access tokens. Server-managed.
    match /investmentTokens/{tokenId} {
      allow read, write: if false;
    }

    // ─── LOI Documents ────────────────────────────────────────────────
    // Letter of Intent documents. Server-managed.
    match /loi/{loiId} {
      allow read, write: if false;
    }

    // ─── Vendor Assignments (top-level, if referenced) ────────────────
    // Legacy or cross-project vendor assignment queries.
    match /vendorAssignments/{assignmentId} {
      allow read, write: if false; // Use project subcollection instead
    }

    // ─── Vendor Inbox (top-level, if referenced) ──────────────────────
    // Legacy reference. Actual inbox is users/{uid}/vendorInbox.
    match /vendorInbox/{itemId} {
      allow read, write: if false; // Use user subcollection instead
    }

    // ─── Financials (top-level, if referenced) ────────────────────────
    match /financials/{docId} {
      allow read, write: if false; // Use project subcollection privateFinancials
    }

    // ─── Metric Snapshots (top-level, legacy) ─────────────────────────
    // Legacy top-level collection. Prefer org subcollection.
    match /metricSnapshots/{snapshotId} {
      allow read: if request.auth != null
                  && hasTenantAccess(resource.data.organizationId);
      allow write: if false; // Admin SDK only
    }

    // ─── Project Files (top-level) ────────────────────────────────────
    match /projectFiles/{fileId} {
      allow read: if request.auth != null
                  && (
                    // Lead Investor / Org member has full access
                    canAccessProject(resource.data.projectId, get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data)
                    // LP / Co-buyer has access to:
                    || (
                      isProjectMemberOrLinked(resource.data.projectId) && (
                        resource.data.uploadedByUid == request.auth.uid
                        || ('recipientUid' in resource.data && resource.data.recipientUid == request.auth.uid)
                        || ('recipientEmail' in resource.data && resource.data.recipientEmail != null && request.auth.token.email != null && resource.data.recipientEmail.lower() == request.auth.token.email.lower())
                        || resource.data.category == 'Deal identity'
                        || ('isPublic' in resource.data && resource.data.isPublic == true)
                      )
                    )
                    // Vendor access based on assigned folder
                    || (
                      ('folderId' in resource.data && resource.data.folderId != null && exists(/databases/$(database)/documents/projectFolders/$(resource.data.folderId))) &&
                      (getFolderForSlotKey(getVendorSlotKey(get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data)) == get(/databases/$(database)/documents/projectFolders/$(resource.data.folderId)).data.name)
                    )
                  );

      allow write: if request.auth != null
                   && (
                     // Lead Investor can write all files
                     hasRole(request.resource.data.projectId, ['Lead Investor'])
                     // LP / Co-buyer can upload their own document
                     || (
                       isProjectMemberOrLinked(request.resource.data.projectId) &&
                       request.resource.data.uploadedByUid == request.auth.uid
                     )
                   );
    }

    // ─── Project Folders (top-level) ──────────────────────────────────
    match /projectFolders/{folderId} {
      allow read: if request.auth != null
                  && (
                    // Lead Investor / Org member has full access
                    canAccessProject(resource.data.projectId, get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data)
                    // LP / Co-buyer has access to read project folders if they are member/linked
                    || isProjectMemberOrLinked(resource.data.projectId)
                    // Vendor access based on assigned folder
                    || (
                      getFolderForSlotKey(getVendorSlotKey(get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data)) == resource.data.name
                    )
                  );

      allow write: if request.auth != null
                   && (
                     // Lead Investor / GC can write folders
                     hasRole(request.resource.data.projectId, ['Lead Investor', 'General Contractor'])
                   );
    }

    // ─── Demo Mode (Public document for guest read-only view) ─────────────────
    match /demo/default {
      allow read: if true;
      allow write: if false;
    }

    // ─── Default: Deny All ─────────────────────────────────────────────
    // Any collection not explicitly matched above is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
