{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": [
    "src/index.ts",
    "src/routes/**/*.ts",
    "src/http/**/*.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
