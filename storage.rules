rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Check if user is a member of the project in Firestore
    function isProjectMember(projectId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/projects/$(projectId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/projects/$(projectId)).data.members;
    }

    // Projects folder: project-scoped document and photography uploads
    match /projects/{projectId}/{allPaths=**} {
      allow read: if request.auth != null && isProjectMember(projectId);
      allow write: if request.auth != null
                   && isProjectMember(projectId)
                   && request.resource.size < 25 * 1024 * 1024; // 25 MB limit
    }

    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // Legacy Deals folder: PDF and receipt uploads scoped by deal ID
    match /deals/{dealId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

