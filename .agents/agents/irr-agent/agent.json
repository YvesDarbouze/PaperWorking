{
  "name": "irr-agent",
  "version": "1.0.0",
  "description": "IRR Agent — The most mathematically advanced REIL metric agent. Manages Internal Rate of Return using Newton-Raphson iteration, multi-scenario comparison, and exit assumptions modeling.",
  "domain": "irr",
  "formula": "IRR = discount rate where NPV of all hold-period cash flows = 0",
  "solver": "Newton-Raphson (100 iterations, 1e-7 tolerance)",
  "seeds": {
    "totalCashInvested": 60000,
    "annualCashFlow": 1722,
    "purchasePrice": 279000,
    "appreciationPercent": 3,
    "loanAmount": 219000,
    "loanRate": 7,
    "loanTermYears": 30,
    "sellingCostsPercent": 8,
    "holdPeriods": [3, 5, 7, 10]
  },
  "scenarioMatrix": {
    "dimensions": "4 hold periods x 3 variants = 12 scenarios",
    "variants": {
      "Bear": { "appreciationPercent": 1.5, "cashFlowMultiplier": 0.8 },
      "Base": { "appreciationPercent": 3.0, "cashFlowMultiplier": 1.0 },
      "Bull": { "appreciationPercent": 5.0, "cashFlowMultiplier": 1.2 }
    },
    "hurdleRate": 0.12
  },
  "components": {
    "input": "IRRExitAssumptionsTerminal.tsx",
    "intelligence": "IRRScenarioComparisonCard.tsx",
    "route": "/dashboard/intelligence/irr"
  },
  "formulas": {
    "computeIRR": "src/lib/metrics/reiMetrics.ts:242",
    "buildIRRCashFlows": "src/lib/metrics/reiMetrics.ts:289"
  },
