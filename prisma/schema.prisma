// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Epic 2: Deep Financial Reporting Models ──────────────────

model DealFinancials {
  id                String   @id @default(uuid())
  organizationId    String
  linkedDealId      String?  @unique // Reference to Firestore Project ID

  // Stored in Cents (BigInt for institutional scale)
  purchasePrice     BigInt   @default(0)
  salePrice         BigInt   @default(0)
  closingCosts      BigInt   @default(0)
  renovationCosts   BigInt   @default(0)
  holdingCosts      BigInt   @default(0)

  // Payee Waterfall summary
  totalPayouts      BigInt   @default(0)

  // Project lifecycle spine fields
  strategyType         String?
  targetPurchasePrice  BigInt?
  capitalRaiseTarget    BigInt?
  committedCapital     BigInt?
  actualRehabCost      BigInt?
  actualRentalIncome   BigInt?
  daysOccupied         Int?
  totalHoldDays         Int?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payouts           PayoutWaterfall[]

  @@index([organizationId])
}

model PayoutWaterfall {
  id                String   @id @default(uuid())
  financialsId      String
  payeeName         String
  payeeRole         String   // e.g. 'Equity Partner', 'Lender', 'Agent', 'Contractor'
  payoutAmount      BigInt   // cents
  isConfirmed       Boolean  @default(false)
  
  // Link back to Firestore LedgerItem
  linkedItemId      String?  @unique
  status            String   @default("Pending") // Pending, Approved, Rejected
  
  createdAt         DateTime @default(now())
  
  financials        DealFinancials @relation(fields: [financialsId], references: [id], onDelete: Cascade)

  @@index([financialsId])
}

model PhaseTransition {
  id                String   @id @default(uuid())
  linkedProjectId   String
  fromPhase         String
  toPhase           String
  transitionDate    DateTime @default(now())
  userUid           String
  notes             String?
  
  @@index([linkedProjectId])
}

// ── Phase 4: Communication Models ────────────────────────────

model CommunicationLog {
  id                String   @id @default(uuid())
  linkedProjectId   String
  organizationId    String
  
  type              String   // 'EMAIL_INBOUND' | 'EMAIL_OUTBOUND' | 'INTERNAL_COMMENT'
  direction         String   // 'IN' | 'OUT'
  
  fromAddress       String
  toAddress         String
  subject           String?
  body              String
  
  providerMessageId String?  @unique // SendGrid/Postmark ID
  threadId          String?  // Logical grouping for UI
  
  createdAt         DateTime @default(now())
  
  @@index([linkedProjectId])
  @@index([organizationId])
  @@index([threadId])
}

/// Per-recipient delivery tracking for transactional emails.
/// Updated by Resend webhook events (Sent → Delivered → Opened → Clicked).
model EmailLog {
  id                String    @id @default(uuid())
  organizationId    String
  recipientId       String?   // Firebase UID of the recipient (null for external)
  recipientEmail    String
  messageId         String    // Resend provider message ID
  templateSlug      String    // e.g. 'phase_advance', 'investor_pledge', 'user_composed'
  linkedProjectId   String?   // Firestore project ID for deal context
  status            String    @default("Sent") // Sent | Delivered | Opened | Clicked | Bounced | Failed
  subject           String?
  sentAt            DateTime  @default(now())
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  errorMessage      String?
  metadata          String?   // JSON: extra context (merge vars, campaign tags, etc.)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId])
  @@index([recipientEmail])
  @@index([messageId])
  @@index([templateSlug])
  @@index([status])
  @@index([linkedProjectId])
}

// ── Bridge API Models ────────────────────────────────────────

model Property {
  id                    String   @id @default(uuid())
  listingKey            String   @unique
  listingId             String   @unique
  
  standardStatus        String?
  listPrice             BigInt?  // cents
  unparsedAddress       String?
  
  // Final Formula Requirements
  bedroomsTotal         Int?
  bathroomsFull         Int?
  bathroomsHalf         Int?
  livingArea            Int?
  lotSizeAcres          Float?
  yearBuilt             Int?
  publicRemarks         String?
  media                 String?  // JSON stringified Media array
  
  bridgeModificationTimestamp DateTime
  
  // Geospatial data (stored as string for SQLite compatibility)
  coordinates           String?  // format: "POINT(lon lat)"
  
  // Licensing & Provenance
  feedTypes             String?  // JSON stringified array ["IDX", "VOW"]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([standardStatus])
  @@index([bridgeModificationTimestamp])
}

model BridgeSyncState {
  id                               String   @id // e.g. "replication_watermark", "member_watermark", "office_watermark"
  mostRecentModificationTimestamp  DateTime
  updatedAt                        DateTime @updatedAt
}

// ── Cached MLS Member (Agent) ────────────────────────────────
// Populated by the Member replication worker from Bridge /Member.
// Keeps a local copy for fast search + directory rendering without
// hitting the Bridge API on every frontend request.

model Member {
  id                  String   @id @default(uuid())
  memberKey           String   @unique
  memberMlsId         String?
  memberFullName      String?
  memberFirstName     String?
  memberLastName      String?
  memberEmail         String?
  memberDirectPhone   String?
  memberMobilePhone   String?
  memberStateLicense  String?
  memberDesignation   String?  // JSON array
  officeName          String?
  officeKey           String?
  officeMlsId         String?
  media               String?  // JSON stringified Media array
  modificationTimestamp DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([memberFullName])
  @@index([officeKey])
  @@index([modificationTimestamp])
}

// ── Cached MLS Office ────────────────────────────────────────
// Populated by the Office replication worker from Bridge /Office.

model Office {
  id                      String   @id @default(uuid())
  officeKey               String   @unique
  officeMlsId             String?
  officeName              String?
  officePhone             String?
  officeEmail             String?
  officeAddress1          String?
  officeCity              String?
  officeStateOrProvince   String?
  officePostalCode        String?
  officeType              String?
  officeStatus            String?
  modificationTimestamp   DateTime?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([officeName])
  @@index([modificationTimestamp])
}

// ── Async Job Queue Audit Log ────────────────────────────────
// Records the lifecycle of every job that passes through the
// Redis queue for observability and DLQ investigation.
// Additive migration — no existing columns modified.

model JobRecord {
  id          String    @id // matches jobQueue.Job.id
  type        String    // 'bridge_sync' | 'member_sync' | 'office_sync' | 'webhook_process'
  status      String    @default("pending") // pending | processing | done | failed | dlq
  payload     String    // JSON
  attempts    Int       @default(0)
  error       String?
  enqueuedAt  DateTime
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([type, status])
  @@index([enqueuedAt])
}

// ── Phase 1: Sourcing Models ──────────────────────────────────

model SourcingLead {
  id                String   @id @default(uuid())
  organizationId    String
  
  // Webhook / Integration origin
  sourceVendor      String   // e.g. "PropStream", "Manual"
  sourceReferenceId String?  // ID from vendor system
  
  // Property Metadata
  address           String
  city              String?
  state             String?
  zipCode           String?
  propertyType      String?
  estimatedValue    BigInt?
  
  // Owner Details
  ownerName         String?
  ownerContact      String?  // JSON or string
  
  // R0: Versioning
  criteriaVersion   String   @default("v1")
  
  // R0: Dual-Scope Metrics
  costPerLead       BigInt?  // Operational metric (cents)
  estimatedMargin   BigInt?  // Financial metric (cents)
  
  // R0: Ownership %
  ownershipShares   Json?  // JSON mapping userId -> percentage
  
  status            String   @default("New") // New, Qualified, Rejected, Converted
  convertedProjectId String? // Link to actual deal/project if converted
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([organizationId])
  @@index([status])
  @@index([sourceVendor])
}

// ── Phase 3: Rehab Models ────────────────────────────────────

model RehabProject {
  id                String   @id @default(uuid())
  linkedProjectId   String   @unique // Link to the central Deal/Project
  organizationId    String
  
  status            String   @default("Planning") // Planning, Bidding, In Progress, Completed, On Hold
  
  // Budget tracking
  estimatedBudget   BigInt   @default(0) // cents
  actualCost        BigInt   @default(0) // cents
  
  // Timeline
  startDate         DateTime?
  endDate           DateTime?
  
  // R0 constraints
  ownershipShares   Json?  // JSON mapping userId -> percentage
  criteriaVersion   String   @default("v1")
  
  // Relations
  milestones        RehabMilestone[]
  changeOrders      ChangeOrder[]
  documents         RehabDocument[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model RehabMilestone {
  id                String   @id @default(uuid())
  rehabProjectId    String
  title             String
  description       String?
  status            String   @default("Pending") // Pending, In Progress, Completed
  
  estimatedCost     BigInt   @default(0) // cents
  actualCost        BigInt   @default(0) // cents
  
  startDate         DateTime?
  endDate           DateTime?
  
  rehabProject      RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)
  bids              VendorBid[]
  invoices          RehabInvoice[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([rehabProjectId])
}

model Vendor {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  type              String   // GC, Plumber, Electrician, etc.
  contactEmail      String?
  contactPhone      String?
  
  bids              VendorBid[]
  invoices          RehabInvoice[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
}

model VendorBid {
  id                String   @id @default(uuid())
  vendorId          String
  milestoneId       String
  
  bidAmount         BigInt   // cents
  status            String   @default("Pending") // Pending, Accepted, Rejected
  notes             String?
  
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  milestone         RehabMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([vendorId])
  @@index([milestoneId])
}

model RehabInvoice {
  id                String   @id @default(uuid())
  vendorId          String
  milestoneId       String
  
  amount            BigInt   // cents
  status            String   @default("Pending") // Pending, Approved, Paid
  documentUrl       String?
  
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  milestone         RehabMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([vendorId])
  @@index([milestoneId])
}

model ChangeOrder {
  id                String   @id @default(uuid())
  rehabProjectId    String
  
  description       String
  requestedCost     BigInt   // cents
  approvedCost      BigInt?  // cents
  status            String   @default("Pending") // Pending, Approved, Rejected
  
  rehabProject      RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([rehabProjectId])
}

model RehabDocument {
  id                String   @id @default(uuid())
  rehabProjectId    String
  
  title             String
  type              String   // Permit, Inspection, Plan, Invoice
  fileUrl           String
  
  rehabProject      RehabProject @relation(fields: [rehabProjectId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  
  @@index([rehabProjectId])
}
