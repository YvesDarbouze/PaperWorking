{
  "name": "@paperworking/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Migrated API handlers — Phase 4 (framework-agnostic route logic)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace=@paperworking/web",
    "start:dev": "npm run dev --workspace=@paperworking/web",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@paperworking/database": "file:../../packages/database",
    "@paperworking/financial-engine": "file:../../packages/financial-engine",
    "@paperworking/shared": "file:../../packages/shared",
    "pdfkit": "^0.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.9",
    "typescript": "^5.8.3"
  }
}
