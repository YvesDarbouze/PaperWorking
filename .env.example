# ═══════════════════════════════════════════════════════════════
# PaperWorking — Environment Variables
#
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All others are server-only.
# ═══════════════════════════════════════════════════════════════

# ─── Firebase (Client — exposed to browser) ───────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=           # Optional — for FCM push notifications

# ─── Firebase (Server — Admin SDK) ────────────────────────────
# Either set these explicitly, or rely on Application Default
# Credentials (ADC) in Cloud Run / Firebase App Hosting.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                     # PEM-encoded; use quotes to preserve newlines

# ─── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Production: https://paperworking.co

# ─── Stripe ───────────────────────────────────────────────────
# STRIPE_PROVIDER selects the checkout adapter: `stripe` (default) | `mock`.
# When STRIPE_SECRET_KEY is empty OR STRIPE_PROVIDER=mock, /api/stripe/checkout
# returns a simulated Checkout Session so the trial flow works without keys.
STRIPE_PROVIDER=                          # leave blank for real Stripe; set `mock` to force the mock adapter
STRIPE_SECRET_KEY=                        # sk_test_... or sk_live_...  (empty ⇒ mock checkout)
STRIPE_WEBHOOK_SECRET=                    # whsec_... from Stripe dashboard

# ─── Resend (Transactional Email) ─────────────────────────────
# Optional in development — emails are mocked when absent.
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=                           # re_...
RESEND_FROM_EMAIL=notifications@paperworking.co
RESEND_WEBHOOK_SECRET=                    # whsec_... — from Resend dashboard → Webhooks → signing secret
                                          # Required for delivery tracking (Delivered, Opened, Clicked, Bounced)
                                          # Endpoint: POST /api/webhooks/resend

# ─── Database (Prisma) ────────────────────────────────────────
DATABASE_URL=                             # postgresql://user:pass@host:5432/dbname

# ─── Google OAuth (Calendar Integration) ──────────────────────
# Optional — only needed for Google Calendar sync feature.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google Service Account (Drive / Calendar server-side) ────
# Optional — only needed for server-side Drive provisioning
# and Calendar sync via service account impersonation.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=         # JSON string of full service account key

# ─── Connected Services — Google Drive OAuth2 ─────────────────
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
# Callback URL to register in Google Cloud Console:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google-drive/callback
# WORKER_SECRET is used to HMAC-sign the OAuth state parameter
# (prevents CSRF). Falls back to a dev default if unset.
# No additional env vars needed beyond what's already above.

# ─── Connected Services — MLS Integration ─────────────────────
# MLS data comes from Bridge Interactive (credentials below).
# When Bridge credentials are absent the API returns credentialsMissing:true and
# the UI shows an honest "credentials not configured" state — no mock MLS fallback.
# MLS_PROVIDER is not read by any code today (reserved for future provider selection).
MLS_PROVIDER=bridge                       # informational only — not yet enforced in code

# ─── E-Signature — DocuSign ───────────────────────────────────
# Optional — when absent the MockESignAdapter is used automatically.
# Set ESIGN_PROVIDER=docusign to activate the real DocuSign adapter.
# Consent must be granted once per integration key before JWT Grant works:
#   https://account-d.docusign.com/oauth/auth?response_type=code&scope=signature+impersonation&client_id=<INTEGRATION_KEY>&redirect_uri=<REDIRECT_URI>
#
# DocuSign Connect webhook:
#   Register POST {NEXT_PUBLIC_APP_URL}/api/webhooks/docusign in
#   DocuSign Admin → Integrations → Connect → Add Configuration.
#   Copy the HMAC key it generates into DOCUSIGN_WEBHOOK_HMAC_KEY.
ESIGN_PROVIDER=mock                       # "docusign" | "mock" (default: mock)
DOCUSIGN_INTEGRATION_KEY=                 # OAuth integration key (client_id) from DocuSign Apps & Keys
DOCUSIGN_USER_ID=                         # DocuSign user GUID to impersonate (from Admin → Users)
DOCUSIGN_PRIVATE_KEY=                     # RSA private key PEM — \n-escaped, wrap in quotes
DOCUSIGN_ACCOUNT_ID=                      # DocuSign account ID (found in Admin → API & Keys)
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi  # Prod: https://na3.docusign.net/restapi
DOCUSIGN_WEBHOOK_HMAC_KEY=                # HMAC key from DocuSign Connect configuration

# ─── Google AI (OCR / Document Intelligence) ──────────────────
# Optional — powers the OCR routes (GC Bids, Inspections, etc.)
GOOGLE_GENERATIVE_AI_API_KEY=             # Or use GEMINI_API_KEY as an alias
GEMINI_API_KEY=

# ─── Google Places ────────────────────────────────────────────
# Server-side only — powers the /api/places/* proxy routes. Never use NEXT_PUBLIC_ here.
GOOGLE_PLACES_API_KEY=
# Client-side Google Maps key — required to load the Maps JS SDK in the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Address provider selection (safe to expose — contains no secrets).
# 'google' → GooglePlacesAdapter via /api/places/* proxy (requires GOOGLE_PLACES_API_KEY)
# 'mock'   → MockAddressProvider with 20 seeded test addresses (no key required)
# Default: mock (unset = mock)
NEXT_PUBLIC_ADDRESS_PROVIDER=google

# ─── Bridge Interactive (MLS Data) ────────────────────────────
# Optional — only needed for MLS property data features.
BRIDGE_SERVER_TOKEN=
BRIDGE_API_BASE_URL=
BRIDGE_VIRTUAL_DATASET_ID=
BRIDGE_DATASET_ID=                        # Optional — falls back to BRIDGE_VIRTUAL_DATASET_ID

# ─── Property Data Providers ──────────────────────────────────
# Production: set to "rentcast". "mock" is keyless dev only — never ship mock as prod default.
# Serving mock in production means hash-derived fake AVM/rent/comps — never acceptable.
PROPERTY_DATA_PROVIDER=rentcast
# Choose: "mock" (keyless dev) or "rentcast" (production)
RENTHISTORY_PROVIDER=rentcast
RENTCAST_API_KEY=
ATTOM_API_KEY=
MASHVISOR_API_KEY=

# ─── Permit Lookup (Socrata Open Data) ───────────────────────
# Controls the permit provider used by GET /api/permits.
# 'mock'   → MockPermitAdapter — deterministic, labeled, no key required (default: mock)
# 'socrata'→ OpenDataSocrataAdapter — live municipal open-data (no key required;
#            SOCRATA_APP_TOKEN is optional but raises rate limits significantly)
# Never leave PERMIT_PROVIDER unset in production — set it explicitly to 'socrata'.
PERMIT_PROVIDER=mock
SOCRATA_APP_TOKEN=                        # Optional — raises Socrata rate limits

# ─── Census API ───────────────────────────────────────────────
# Optional — market vitals work without key at lower rate limits.
CENSUS_API_KEY=

# ─── Inbound Email ────────────────────────────────────────────
# Optional — domain for reply-to addresses on outbound emails.
INBOUND_EMAIL_DOMAIN=

# ─── Cron / Worker Auth ───────────────────────────────────────
# Secret used to authenticate cron job endpoints.
CRON_SECRET=
WORKER_SECRET=                            # Alias for CRON_SECRET

# ─── PostHog (Telemetry) ──────────────────────────────────────
# Optional — fallbacks to console log stub when POSTHOG_ENABLED is false.
POSTHOG_ENABLED=false
POSTHOG_API_KEY=                          # phc_...
POSTHOG_HOST=https://us.i.posthog.com     # Optional — defaults to US cloud

# ─── MCP API (Model Context Protocol) ────────────────────────
# Bearer token for the MCP endpoint at /api/mcp/[transport].
# Without this key the endpoint returns 503 (never open by default).
# AI agents (Claude Code, etc.) must supply: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=

# ─── Sourcing Webhook ─────────────────────────────────────────
# Bearer token for the inbound lead webhook at /api/webhooks/sourcing.
# Without this key the endpoint returns 503 (never open by default).
# Sourcing vendors must supply: Authorization: Bearer <SOURCING_WEBHOOK_SECRET>
SOURCING_WEBHOOK_SECRET=

# ─── Inbound Email Webhook ────────────────────────────────────
# Bearer token for the inbound email webhook at /api/webhooks/emails.
# Without this key the endpoint returns 503 (never open by default).
# Set in your SendGrid/Postmark webhook URL header: Authorization: Bearer <token>
INBOUND_EMAIL_WEBHOOK_SECRET=

# ─── Worker / Queue Auth ──────────────────────────────────────
# Required for /api/worker/drain — must be set or the endpoint returns 503.
# WORKER_SECRET is already listed above under "Cron / Worker Auth" —
# this note is here as a reminder that the endpoint is now HARD-BLOCKED without it.

# ─── Webhook HMAC Keys ────────────────────────────────────────
# All webhook endpoints below return 503 if their key is absent (never silently open).
BRIDGE_WEBHOOK_SECRET=           # HMAC-SHA256 shared secret from Bridge Interactive
DOCUSIGN_WEBHOOK_HMAC_KEY=       # HMAC-SHA256 key from DocuSign Connect configuration
RESEND_WEBHOOK_SECRET=           # Svix signing secret (whsec_...) from Resend dashboard

# ─── Support Provider ─────────────────────────────────────────
# Controls the support widget data persistence.
# 'mock'      → MockSupportProvider using localStorage/state simulation (default)
# 'firestore' → FirestoreSupportProvider writing to the supportTickets collection
NEXT_PUBLIC_SUPPORT_PROVIDER=mock

# ─── Title Search / Closing Provider ──────────────────────────
# Selects the active title provider adapter: `qualia` (mock) | `manual` (manual entry)
# Default: manual
TITLE_PROVIDER=manual
