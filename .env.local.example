# ==============================================================================
# PaperWorking Firebase & Local Development Configuration (.env.local.example)
# ==============================================================================
# Copy this file to .env.local (which is strictly gitignored).
# NEVER commit service account credentials or private keys to the repository.

# --- Application Mode ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Firebase Client SDK (browser-only, safe for public bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeKeyForLocalEmulatorTesting000
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-paperworking.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-paperworking
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-paperworking.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=100000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:100000000000:web:abcdef1234567890

# --- Firebase Admin SDK (server-only, NEVER bundle to client) ---
FIREBASE_ADMIN_PROJECT_ID=demo-paperworking
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@demo-paperworking.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY is only required for live Google Cloud production/staging.
# Leave blank/omitted when using the local Firebase Emulator Suite (demo-* projects).
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Firebase Emulator Suite Toggles ---
# Set to "true" or "1" to automatically connect client & server SDKs to local emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Google Maps Platform ---
# Client-side Maps JavaScript & Places Autocomplete (browser-safe, restricted by HTTP referrers)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyFakeClientKeyForLocalDev0000000000
# Server-side proxy for Static Maps, Street View & Geocoding (server-only, never exposed to client)
GOOGLE_MAPS_API_KEY=AIzaSyFakeServerKeyForProxyTesting0000000000
